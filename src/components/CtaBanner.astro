---
// CTA Banner — cursor-tracking radial gradient background
---

<section id="cta-banner" class="relative py-20 px-4 sm:px-6 overflow-hidden">
    <!-- Static base gradient layer -->
    <div
        class="pointer-events-none absolute inset-0 bg-gradient-to-r from-cyan/5 via-transparent to-pink/5"
        aria-hidden="true"
    >
    </div>

    <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
        <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-clean">
            Start syncing your links —
            <span
                class="bg-gradient-to-r from-cyan to-pink bg-clip-text text-transparent"
            >
                it's free.</span
            >
        </h2>
        <p class="text-muted text-base sm:text-lg">
            Join thousands of creators and marketers who trust Zync to power
            their link strategy.
        </p>
        <div
            class="flex flex-col sm:flex-row items-center justify-center gap-3"
        >
            <a
                href="/signup"
                id="cta-signup-btn"
                class="w-full sm:w-auto px-8 py-4 bg-cyan hover:bg-cyan/90 text-midnight font-bold rounded-xl text-base active:scale-95 transition-all duration-150 shadow-[0_0_24px_rgba(6,182,212,0.45)] hover:shadow-[0_0_36px_rgba(6,182,212,0.65)]"
            >
                Get Started — It's Free
            </a>
            <a
                href="#features"
                class="w-full sm:w-auto px-8 py-4 border border-white/10 text-muted hover:text-clean hover:border-white/20 font-semibold rounded-xl text-base transition-all duration-200"
            >
                See all features
            </a>
        </div>
    </div>
</section>

<!-- is:inline prevents Astro bundling/dedup so it always runs fresh -->
<script is:inline>
    (function () {
        var section = document.getElementById("cta-banner");
        var spotlight = document.getElementById("cta-spotlight");

        if (!section || !spotlight) return;

        function lerp(a, b, t) {
            return Math.round(a + (b - a) * t);
        }

        // Cyan #06B6D4 and Pink #EC4899
        var cyan = { r: 6, g: 182, b: 212 };
        var pink = { r: 236, g: 72, b: 153 };

        section.addEventListener("mousemove", function (e) {
            var rect = section.getBoundingClientRect();
            var x = e.clientX - rect.left;
            var y = e.clientY - rect.top;

            // 0 = full cyan (left), 1 = full pink (right), tilt by Y too
            var t = (x / rect.width) * 0.75 + (y / rect.height) * 0.25;
            t = Math.min(1, Math.max(0, t));

            var r = lerp(cyan.r, pink.r, t);
            var g = lerp(cyan.g, pink.g, t);
            var b = lerp(cyan.b, pink.b, t);

            spotlight.style.background =
                "radial-gradient(600px circle at " +
                x +
                "px " +
                y +
                "px, " +
                "rgba(" +
                r +
                "," +
                g +
                "," +
                b +
                ",0.22) 0%, " +
                "rgba(" +
                r +
                "," +
                g +
                "," +
                b +
                ",0.07) 45%, " +
                "transparent 70%)";

            spotlight.style.opacity = "1";
        });

        section.addEventListener("mouseleave", function () {
            spotlight.style.opacity = "0";
        });
    })();
</script>
