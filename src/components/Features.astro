---
// Features section — 3-column responsive grid of feature cards
---

<section id="features" class="relative py-24 px-4 sm:px-6">
    <div class="max-w-6xl mx-auto space-y-14">
        <!-- Section header -->
        <div class="text-center space-y-3">
            <p
                class="text-xs font-semibold tracking-widest uppercase text-cyan"
            >
                Why Zync?
            </p>
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-clean">
                Built for creators who
                <span
                    class="bg-gradient-to-r from-cyan to-pink bg-clip-text text-transparent"
                >
                    mean business.</span
                >
            </h2>
            <p class="text-muted max-w-xl mx-auto text-base sm:text-lg">
                Every link is an opportunity. Zync makes sure you never miss
                one.
            </p>
        </div>

        <!-- Cards grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
            <!-- Card 1: Deep Linking -->
            <article
                id="feature-deep-linking"
                class="group relative flex flex-col gap-5 p-7 rounded-2xl bg-river border border-white/5 cursor-default hover:border-cyan/30 hover:scale-[1.025] hover:shadow-[0_0_40px_rgba(6,182,212,0.12)] transition-all duration-300"
            >
                <div
                    class="flex items-center justify-center w-12 h-12 rounded-xl bg-cyan/10 border border-cyan/20 group-hover:bg-cyan/20 transition-colors"
                >
                    <svg
                        class="w-6 h-6 text-cyan"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                        ></path>
                    </svg>
                </div>
                <span
                    class="absolute top-5 right-5 text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded-full bg-cyan/15 text-cyan border border-cyan/20"
                >
                    Pro
                </span>
                <div class="space-y-2">
                    <h3 class="text-lg font-bold text-clean">Deep Linking</h3>
                    <p class="text-sm text-muted leading-relaxed">
                        Skip the browser redirect. Force-open Instagram,
                        YouTube, TikTok, and Spotify directly in-app for a
                        frictionless experience that converts.
                    </p>
                </div>
                <div
                    class="mt-auto pt-2 flex items-center gap-1.5 text-xs font-semibold text-cyan group-hover:gap-3 transition-all"
                >
                    Learn more
                    <svg
                        class="w-3.5 h-3.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </div>
            </article>

            <!-- Card 2: AI Meta-Tag Editor -->
            <article
                id="feature-ai-meta"
                class="group relative flex flex-col gap-5 p-7 rounded-2xl bg-river border border-white/5 cursor-default hover:border-pink/30 hover:scale-[1.025] hover:shadow-[0_0_40px_rgba(236,72,153,0.1)] transition-all duration-300"
            >
                <div
                    class="flex items-center justify-center w-12 h-12 rounded-xl bg-pink/10 border border-pink/20 group-hover:bg-pink/20 transition-colors"
                >
                    <svg
                        class="w-6 h-6 text-pink"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="absolute top-5 right-5 text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded-full bg-gradient-to-r from-cyan/20 to-pink/20 text-pink border border-pink/20"
                >
                    AI
                </span>
                <div class="space-y-2">
                    <h3 class="text-lg font-bold text-clean">
                        AI Meta-Tag Editor
                    </h3>
                    <p class="text-sm text-muted leading-relaxed">
                        Customize OG thumbnails, titles, and descriptions for
                        any link — powered by AI. Make every social share pop
                        without touching any code.
                    </p>
                </div>
                <div
                    class="mt-auto pt-2 flex items-center gap-1.5 text-xs font-semibold text-pink group-hover:gap-3 transition-all"
                >
                    Learn more
                    <svg
                        class="w-3.5 h-3.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </div>
            </article>

            <!-- Card 3: Phishing Shield -->
            <article
                id="feature-phishing-shield"
                class="group relative flex flex-col gap-5 p-7 rounded-2xl bg-river border border-white/5 cursor-default hover:border-cyan/30 hover:scale-[1.025] hover:shadow-[0_0_40px_rgba(6,182,212,0.12)] transition-all duration-300"
            >
                <div
                    class="flex items-center justify-center w-12 h-12 rounded-xl bg-cyan/10 border border-cyan/20 group-hover:bg-cyan/20 transition-colors"
                >
                    <svg
                        class="w-6 h-6 text-cyan"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="1.8"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"
                        ></path>
                    </svg>
                </div>
                <span
                    class="absolute top-5 right-5 text-[10px] font-bold tracking-widest uppercase px-2 py-0.5 rounded-full bg-cyan/15 text-cyan border border-cyan/20"
                >
                    ML
                </span>
                <div class="space-y-2">
                    <h3 class="text-lg font-bold text-clean">
                        Phishing Shield
                    </h3>
                    <p class="text-sm text-muted leading-relaxed">
                        Every link scanned in real time. Our ML model flags
                        spam, malware, and phishing URLs before they reach your
                        audience — keeping your brand safe.
                    </p>
                </div>
                <div
                    class="mt-auto pt-2 flex items-center gap-1.5 text-xs font-semibold text-cyan group-hover:gap-3 transition-all"
                >
                    Learn more
                    <svg
                        class="w-3.5 h-3.5"
                        fill="none"
                        stroke="currentColor"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            stroke-width="2.5"
                            d="M9 5l7 7-7 7"></path>
                    </svg>
                </div>
            </article>
        </div>
    </div>
</section>
