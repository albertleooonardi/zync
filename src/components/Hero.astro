---
// Hero section — fullscreen, glassmorphism URL input, glow blobs
---

<section
    class="relative min-h-screen flex flex-col items-center justify-center px-4 sm:px-6 overflow-hidden pt-16"
>
    <!-- Background glow blobs -->
    <div
        class="pointer-events-none absolute inset-0 overflow-hidden"
        aria-hidden="true"
    >
        <div
            class="absolute -top-32 left-1/2 -translate-x-1/2 w-[700px] h-[700px] rounded-full bg-cyan/10 blur-[120px]"
        >
        </div>
        <div
            class="absolute top-1/2 left-1/4 -translate-y-1/2 w-[400px] h-[400px] rounded-full bg-pink/8 blur-[100px]"
        >
        </div>
        <div
            class="absolute bottom-0 right-0 w-[350px] h-[350px] rounded-full bg-cyan/6 blur-[80px]"
        >
        </div>
    </div>

    <!-- Content -->
    <div class="relative z-10 max-w-3xl mx-auto text-center space-y-6">
        <!-- Animated badge -->
        <div
            class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-cyan/30 bg-cyan/10 text-cyan text-xs font-semibold tracking-widest uppercase"
        >
            <span
                class="inline-block w-1.5 h-1.5 rounded-full bg-cyan animate-pulse"
            ></span>
            Now with AI Meta-Tag Editor
        </div>

        <!-- Headline -->
        <h1
            class="text-4xl sm:text-5xl md:text-6xl lg:text-7xl font-black leading-[1.05] tracking-tight"
        >
            <span class="text-clean drop-shadow-[0_0_40px_rgba(6,182,212,0.4)]"
                >Sync Your Links.</span
            >
            <br />
            <span
                class="bg-gradient-to-r from-cyan via-cyan/80 to-pink bg-clip-text text-transparent"
            >
                Track Your Growth.
            </span>
        </h1>

        <!-- Sub-headline -->
        <p
            class="text-base sm:text-lg md:text-xl text-muted max-w-xl mx-auto leading-relaxed"
        >
            The ultimate URL shortener with smart analytics, deep linking, and
            AI-powered meta tags.
        </p>

        <!-- Glassmorphism URL input -->
        <div class="mt-8 w-full max-w-2xl mx-auto">
            <div
                class="relative p-1.5 sm:p-2 rounded-2xl border border-white/10 bg-white/5 backdrop-blur-md shadow-[0_8px_32px_rgba(0,0,0,0.4),inset_0_1px_0_rgba(255,255,255,0.06)]"
            >
                <div class="flex flex-col sm:flex-row gap-2 sm:gap-0">
                    <input
                        id="url-input"
                        type="url"
                        placeholder="Paste your long URL here..."
                        class="flex-1 bg-transparent px-4 py-3.5 text-sm sm:text-base text-clean placeholder:text-muted/60 outline-none rounded-xl sm:rounded-r-none focus:ring-1 focus:ring-cyan/40 transition-shadow"
                        aria-label="URL to shorten"
                    />
                    <button
                        id="zync-it-btn"
                        type="button"
                        class="px-6 py-3.5 bg-cyan hover:bg-cyan/90 text-midnight text-sm sm:text-base font-bold rounded-xl sm:rounded-l-none whitespace-nowrap active:scale-95 transition-all duration-150 shadow-[0_0_20px_rgba(6,182,212,0.5)] hover:shadow-[0_0_28px_rgba(6,182,212,0.7)]"
                    >
                        Zync It! ⚡
                    </button>
                </div>
            </div>
            <p class="mt-3 text-xs text-muted/60 text-center">
                Free forever.
                <a
                    href="/register"
                    class="text-cyan/80 hover:text-cyan underline underline-offset-2 transition-colors"
                    >Create an account</a
                >
                to get started.
            </p>
        </div>

        <!-- Trust badges -->
        <div
            class="flex flex-wrap items-center justify-center gap-x-6 gap-y-2 pt-2 text-xs text-muted/70"
        >
            <span class="flex items-center gap-1.5">
                <svg
                    class="w-3.5 h-3.5 text-cyan"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                </svg>
                No credit card required
            </span>
            <span class="flex items-center gap-1.5">
                <svg
                    class="w-3.5 h-3.5 text-cyan"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                </svg>
                Free forever plan
            </span>
            <span class="flex items-center gap-1.5">
                <svg
                    class="w-3.5 h-3.5 text-cyan"
                    fill="currentColor"
                    viewBox="0 0 20 20"
                >
                    <path
                        fill-rule="evenodd"
                        d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z"
                        clip-rule="evenodd"></path>
                </svg>
                Early access — free to join
            </span>
        </div>
    </div>

    <!-- Scroll indicator -->
    <div
        class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center gap-1 text-muted/40 animate-bounce"
        aria-hidden="true"
    >
        <span class="text-xs tracking-widest uppercase">Scroll</span>
        <svg
            class="w-4 h-4"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
        >
            <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M19 9l-7 7-7-7"></path>
        </svg>
    </div>
</section>

<script>
    const btn = document.getElementById("zync-it-btn");
    const input = document.getElementById("url-input") as HTMLInputElement;

    btn?.addEventListener("click", () => {
        const val = input?.value.trim();
        if (!val) {
            input?.classList.add("ring-1", "ring-pink/60");
            input?.focus();
            setTimeout(
                () => input?.classList.remove("ring-1", "ring-pink/60"),
                1800
            );
            return;
        }
        if (btn) {
            const original = btn.textContent;
            btn.textContent = "Synced! ✓";
            btn.classList.add("bg-green-400");
            btn.classList.remove("bg-cyan");
            setTimeout(() => {
                btn.textContent = original;
                btn.classList.remove("bg-green-400");
                btn.classList.add("bg-cyan");
            }, 2000);
        }
    });
</script>
