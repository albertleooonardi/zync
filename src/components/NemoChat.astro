---
// Nemo — floating AI chat assistant
// Injected in Layout.astro, visible on every page
---

<!-- FAB toggle button (always visible) -->
<button
    id="nemo-toggle"
    aria-label="Open Nemo AI assistant"
    class="fixed bottom-5 right-5 z-[9999] flex items-center gap-2 px-3.5 py-2.5 rounded-2xl bg-[#0e1520] border border-white/10 shadow-[0_0_24px_rgba(6,182,212,0.3)] hover:shadow-[0_0_36px_rgba(6,182,212,0.5)] hover:border-cyan/30 hover:scale-105 active:scale-95 transition-all duration-200 group"
>
    <span class="text-base select-none transition-transform duration-300 group-hover:-rotate-12">🐠</span>
    <span class="text-clean text-xs font-semibold tracking-wide" id="nemo-toggle-label">Ask Nemo</span>
</button>

<!-- Mobile backdrop -->
<div id="nemo-backdrop" class="fixed inset-0 z-[9997] bg-black/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 sm:hidden"></div>

<!-- Chat window -->
<div
    id="nemo-window"
    class="
        fixed z-[9998]
        flex flex-col
        bg-[#0e1520] border border-white/8
        overflow-hidden

        /* Mobile: full screen */
        inset-0
        rounded-none

        /* Desktop: bottom-right panel */
        sm:inset-auto sm:bottom-20 sm:right-5
        sm:w-[360px] sm:h-[520px]
        sm:rounded-2xl sm:shadow-[0_24px_64px_rgba(0,0,0,0.6)]
    "
    style="opacity:0; transform:scale(0.95) translateY(12px); pointer-events:none;"
>
    <!-- Header -->
    <div class="flex-shrink-0 flex items-center gap-3 px-4 py-3 border-b border-white/8 bg-[#0a1018]">
        <!-- Mobile back button -->
        <button id="nemo-back" class="sm:hidden mr-1 w-8 h-8 flex items-center justify-center rounded-lg text-muted hover:text-clean hover:bg-white/8 transition-colors" aria-label="Close chat">
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 19l-7-7 7-7"/>
            </svg>
        </button>
        <div class="w-8 h-8 flex-shrink-0 rounded-xl bg-cyan/10 border border-cyan/20 flex items-center justify-center text-base">🐠</div>
        <div class="flex-1 min-w-0">
            <p class="text-sm font-semibold text-clean leading-tight">Nemo</p>
            <p class="text-[11px] text-muted leading-tight">Zync AI · Groq</p>
        </div>
        <!-- Status dot -->
        <span class="flex items-center gap-1.5 text-[11px] text-emerald-400/80 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-400 animate-pulse"></span>
            Online
        </span>
        <!-- Desktop close button -->
        <button id="nemo-close" class="hidden sm:flex w-7 h-7 items-center justify-center rounded-lg text-muted hover:text-clean hover:bg-white/8 transition-colors text-lg leading-none" aria-label="Close chat">×</button>
    </div>

    <!-- Messages area — flex-1 + min-h-0 to properly scroll without overflowing -->
    <div id="nemo-messages" class="flex-1 min-h-0 overflow-y-auto px-4 py-4 space-y-4">
        <!-- Welcome bubble -->
        <div class="flex gap-2.5 items-end">
            <span class="text-sm flex-shrink-0 mb-0.5">🐠</span>
            <div class="bg-white/5 border border-white/8 rounded-2xl rounded-bl-sm px-3.5 py-2.5 text-sm text-clean/85 leading-relaxed max-w-[88%]">
                Hey! I'm <strong class="text-cyan">Nemo</strong> 👋<br/>
                Ask me anything about Zync — I can also shorten links and pull up your stats!
            </div>
        </div>
    </div>

    <!-- Quick suggestions -->
    <div id="nemo-suggestions" class="flex-shrink-0 px-4 pb-2.5 flex flex-wrap gap-1.5">
        {["Create a short link", "What is A/B routing?", "Show my link stats", "How does Geo-Routing work?"].map((s) => (
            <button
                type="button"
                class="suggestion-btn text-[11px] px-2.5 py-1 rounded-lg bg-white/4 border border-white/8 text-muted/80 hover:text-cyan hover:border-cyan/25 hover:bg-cyan/5 transition-all duration-150 whitespace-nowrap"
            >
                {s}
            </button>
        ))}
    </div>

    <!-- Input row -->
    <div class="flex-shrink-0 flex items-center gap-2 px-3 py-3 border-t border-white/8 bg-[#0a1018]">
        <input
            id="nemo-input"
            type="text"
            placeholder="Ask Nemo anything…"
            autocomplete="off"
            class="flex-1 min-w-0 bg-white/5 border border-white/8 rounded-xl px-3.5 py-2 text-sm text-clean placeholder:text-muted/40 outline-none focus:border-cyan/40 focus:bg-white/7 transition-all duration-200"
        />
        <button
            id="nemo-send"
            type="button"
            class="flex-shrink-0 w-9 h-9 flex items-center justify-center rounded-xl bg-cyan hover:bg-cyan/85 text-midnight transition-all duration-150 active:scale-90 disabled:opacity-30"
            aria-label="Send message"
        >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.269 20.876L5.999 12zm0 0h7.5"/>
            </svg>
        </button>
    </div>
</div>

<script is:inline>
(function () {
    const toggle       = document.getElementById("nemo-toggle");
    const toggleLabel  = document.getElementById("nemo-toggle-label");
    const win          = document.getElementById("nemo-window");
    const closeBtn     = document.getElementById("nemo-close");
    const backBtn      = document.getElementById("nemo-back");
    const backdrop     = document.getElementById("nemo-backdrop");
    const input        = document.getElementById("nemo-input");
    const sendBtn      = document.getElementById("nemo-send");
    const messagesEl   = document.getElementById("nemo-messages");
    const suggestionsEl = document.getElementById("nemo-suggestions");

    let isOpen   = false;
    let isLoading = false;
    let messages  = []; // { role: "user"|"model", text }

    const isMobile = () => window.innerWidth < 640;

    function openChat() {
        isOpen = true;

        if (isMobile()) {
            // Full-page: no transform needed, just fade in
            win.style.transition  = "opacity 0.28s cubic-bezier(0.4,0,0.2,1)";
            win.style.opacity     = "1";
            win.style.transform   = "none";
            backdrop.style.opacity = "1";
            backdrop.style.pointerEvents = "auto";
            document.body.style.overflow = "hidden";
        } else {
            // Desktop: pop-up from bottom-right
            win.style.transition  = "opacity 0.25s cubic-bezier(0.34,1.56,0.64,1), transform 0.25s cubic-bezier(0.34,1.56,0.64,1)";
            win.style.opacity     = "1";
            win.style.transform   = "scale(1) translateY(0)";
        }

        win.style.pointerEvents = "auto";
        toggleLabel.textContent = "Close";
        toggle.classList.add("border-cyan/30");
        setTimeout(() => input?.focus(), 50);
    }

    function closeChat() {
        isOpen = false;

        if (isMobile()) {
            win.style.transition = "opacity 0.2s ease";
            win.style.opacity    = "0";
            backdrop.style.opacity = "0";
            backdrop.style.pointerEvents = "none";
            document.body.style.overflow = "";
        } else {
            win.style.transition = "opacity 0.18s ease, transform 0.18s ease";
            win.style.opacity    = "0";
            win.style.transform  = "scale(0.95) translateY(12px)";
        }

        win.style.pointerEvents = "none";
        toggleLabel.textContent = "Ask Nemo";
        toggle.classList.remove("border-cyan/30");
    }

    toggle.addEventListener("click", () => isOpen ? closeChat() : openChat());
    closeBtn?.addEventListener("click", closeChat);
    backBtn?.addEventListener("click", closeChat);
    backdrop?.addEventListener("click", closeChat);

    // Close on desktop outside click
    document.addEventListener("click", (e) => {
        if (!isMobile() && isOpen && !win.contains(e.target) && e.target !== toggle && !toggle.contains(e.target)) {
            closeChat();
        }
    });

    // ── Message rendering ────────────────────────────────────────────────────

    function appendMessage(role, html) {
        const isUser = role === "user";
        const row = document.createElement("div");
        row.className = `flex gap-2.5 items-end animate-in ${isUser ? "flex-row-reverse" : ""}`;

        const bubble = document.createElement("div");
        bubble.className = isUser
            ? "bg-cyan/15 border border-cyan/20 rounded-2xl rounded-br-sm px-3.5 py-2 text-sm text-clean/90 leading-relaxed max-w-[85%] break-words"
            : "prose prose-sm prose-invert prose-p:mt-0 prose-p:mb-3 last:prose-p:mb-0 prose-ul:my-2 prose-li:my-0.5 prose-strong:text-cyan prose-a:text-cyan prose-code:text-cyan prose-code:bg-white/8 prose-code:px-1 prose-code:rounded bg-white/5 border border-white/8 rounded-2xl rounded-bl-sm px-3.5 py-3 text-sm text-clean/85 leading-relaxed max-w-[88%] break-words";

        if (isUser) {
            bubble.textContent = html;
        } else {
            bubble.innerHTML = window.parseMarkdown ? window.parseMarkdown(html) : html;
        }

        if (!isUser) {
            const icon = document.createElement("span");
            icon.className = "text-sm flex-shrink-0 mb-0.5";
            icon.textContent = "🐠";
            row.appendChild(icon);
        }
        row.appendChild(bubble);
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
        return bubble;
    }

    function showTyping() {
        const row = document.createElement("div");
        row.id = "nemo-typing";
        row.className = "flex gap-2.5 items-end";
        row.innerHTML = `
            <span class="text-sm flex-shrink-0 mb-0.5">🐠</span>
            <div class="bg-white/5 border border-white/8 rounded-2xl rounded-bl-sm px-4 py-3 flex gap-1.5 items-center">
                <span class="w-1.5 h-1.5 rounded-full bg-muted/50 animate-bounce" style="animation-delay:0ms"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-muted/50 animate-bounce" style="animation-delay:160ms"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-muted/50 animate-bounce" style="animation-delay:320ms"></span>
            </div>`;
        messagesEl.appendChild(row);
        messagesEl.scrollTop = messagesEl.scrollHeight;
    }

    function removeTyping() {
        document.getElementById("nemo-typing")?.remove();
    }

    // ── Send ─────────────────────────────────────────────────────────────────

    async function send(text) {
        if (!text.trim() || isLoading) return;
        isLoading = true;
        sendBtn.disabled = true;

        if (messages.length === 0) {
            suggestionsEl.style.display = "none";
        }

        messages.push({ role: "user", text });
        appendMessage("user", text);
        input.value = "";
        showTyping();

        try {
            const res  = await fetch("/api/chat", {
                method : "POST",
                headers: { "Content-Type": "application/json" },
                body   : JSON.stringify({ messages }),
            });
            const data = await res.json();
            removeTyping();
            const reply = data.reply || data.error || "Sorry, something went wrong.";
            messages.push({ role: "model", text: reply });
            appendMessage("model", reply);
        } catch {
            removeTyping();
            appendMessage("model", "I'm having trouble connecting. Please try again. 🙏");
        } finally {
            isLoading = false;
            sendBtn.disabled = false;
            input.focus();
        }
    }

    sendBtn.addEventListener("click", () => send(input.value));
    input.addEventListener("keydown", (e) => {
        if (e.key === "Enter" && !e.shiftKey) { e.preventDefault(); send(input.value); }
    });

    document.querySelectorAll(".suggestion-btn").forEach((btn) => {
        btn.addEventListener("click", () => send(btn.textContent.trim()));
    });
})();
</script>

<script>
    import { marked } from "marked";

    declare global {
        interface Window {
            parseMarkdown: (text: string) => string | Promise<string>;
        }
    }

    window.parseMarkdown = (text) => marked.parse(text, { async: false });
</script>

<style is:global>
    /* Smooth message entrance */
    @keyframes chat-in {
        from { opacity: 0; transform: translateY(6px); }
        to   { opacity: 1; transform: translateY(0); }
    }
    .animate-in {
        animation: chat-in 0.2s ease forwards;
    }

    /* Thin scrollbar inside messages */
    #nemo-messages::-webkit-scrollbar       { width: 3px; }
    #nemo-messages::-webkit-scrollbar-track { background: transparent; }
    #nemo-messages::-webkit-scrollbar-thumb { background: rgba(255,255,255,0.08); border-radius: 2px; }
    #nemo-messages::-webkit-scrollbar-thumb:hover { background: rgba(255,255,255,0.15); }

    /* Ensure paragraphs have consistent spacing */
    #nemo-messages .prose > p + p {
        margin-top: 0.65rem;
    }
    #nemo-messages .prose > p:first-child {
        margin-top: 0;
    }
    #nemo-messages .prose > p:last-child {
        margin-bottom: 0;
    }
    /* Keep code and long text from overflowing */
    #nemo-messages .prose pre {
        max-width: 100%;
        overflow-x: auto;
        white-space: pre-wrap;
        word-break: break-word;
    }
    #nemo-messages .prose p,
    #nemo-messages .prose li {
        word-break: break-word;
        overflow-wrap: anywhere;
    }
</style>
