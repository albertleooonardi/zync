---
// Nemo — floating AI chat assistant
// Injected in Layout.astro, visible on every page
---

<!-- Floating button -->
<div id="nemo-root">
    <button
        id="nemo-toggle"
        aria-label="Open Nemo AI assistant"
        class="fixed bottom-5 right-5 z-[9999] flex items-center gap-2.5 px-4 py-3 rounded-2xl bg-gradient-to-br from-cyan to-blue-500 shadow-[0_0_28px_rgba(6,182,212,0.55)] hover:shadow-[0_0_40px_rgba(6,182,212,0.75)] hover:scale-105 active:scale-95 transition-all duration-200 group"
    >
        <!-- Fish icon -->
        <span
            class="text-lg select-none transition-transform duration-300 group-hover:-rotate-12"
            >🐠</span
        >
        <span class="text-midnight text-sm font-bold">Nemo</span>
    </button>

    <!-- Chat window -->
    <div
        id="nemo-window"
        class="fixed bottom-20 right-5 z-[9998] w-80 sm:w-96 rounded-2xl bg-[#111827] border border-white/10 shadow-2xl shadow-black/50 flex flex-col overflow-hidden transition-all duration-300 origin-bottom-right"
        style="opacity:0; transform:scale(0.9) translateY(8px); pointer-events:none; height:480px;"
    >
        <!-- Header -->
        <div
            class="flex items-center gap-3 px-4 py-3.5 bg-gradient-to-r from-cyan/15 to-blue-500/10 border-b border-white/8"
        >
            <span class="text-xl">🐠</span>
            <div class="flex-1 min-w-0">
                <p class="text-sm font-bold text-clean">Nemo</p>
                <p class="text-xs text-cyan/70 font-medium">
                    AI Assistant · Powered by Gemini
                </p>
            </div>
            <button
                id="nemo-close"
                class="w-7 h-7 flex items-center justify-center rounded-lg text-muted hover:text-clean hover:bg-white/8 transition-colors text-lg leading-none"
                >×</button
            >
        </div>

        <!-- Messages -->
        <div
            id="nemo-messages"
            class="flex-1 overflow-y-auto p-3.5 space-y-3 scroll-smooth"
        >
            <!-- Welcome message -->
            <div class="flex gap-2.5 items-start">
                <span class="text-base flex-shrink-0 mt-0.5">🐠</span>
                <div
                    class="bg-white/6 rounded-2xl rounded-tl-sm px-3.5 py-2.5 text-sm text-clean/90 leading-relaxed max-w-[85%]"
                >
                    Hi! I'm <strong class="text-cyan">Nemo</strong> 👋 I'm here to
                    help you get the most out of Zync.<br /><br />
                    Ask me anything — how to shorten a link, set up smart features,
                    view analytics, or anything else!
                </div>
            </div>
        </div>

        <!-- Quick suggestions -->
        <div id="nemo-suggestions" class="px-3.5 pb-2 flex flex-wrap gap-1.5">
            {
                [
                    "How do I create a short link?",
                    "What is A/B routing?",
                    "How do analytics work?",
                    "What is the Meta-Tag Optimizer?",
                ].map((s) => (
                    <button
                        type="button"
                        class="suggestion-btn text-xs px-2.5 py-1 rounded-lg bg-white/5 border border-white/10 text-muted hover:text-cyan hover:border-cyan/30 transition-all duration-150"
                    >
                        {s}
                    </button>
                ))
            }
        </div>

        <!-- Input row -->
        <div class="flex gap-2 p-3 border-t border-white/8 bg-black/20">
            <input
                id="nemo-input"
                type="text"
                placeholder="Ask Nemo anything…"
                autocomplete="off"
                class="flex-1 bg-white/5 border border-white/10 rounded-xl px-3.5 py-2.5 text-sm text-clean placeholder:text-muted/50 outline-none focus:border-cyan/50 focus:ring-1 focus:ring-cyan/20 transition-all"
            />
            <button
                id="nemo-send"
                type="button"
                class="w-10 h-10 flex items-center justify-center rounded-xl bg-cyan hover:bg-cyan/85 text-midnight transition-all duration-150 active:scale-90 disabled:opacity-40"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M6 12L3.269 3.126A59.768 59.768 0 0121.485 12 59.77 59.77 0 013.269 20.876L5.999 12zm0 0h7.5"
                    ></path>
                </svg>
            </button>
        </div>
    </div>
</div>

<script is:inline>
    (function () {
        const toggle = document.getElementById("nemo-toggle");
        const win = document.getElementById("nemo-window");
        const closeBtn = document.getElementById("nemo-close");
        const input = document.getElementById("nemo-input");
        const sendBtn = document.getElementById("nemo-send");
        const messagesEl = document.getElementById("nemo-messages");
        const suggestionsEl = document.getElementById("nemo-suggestions");

        let isOpen = false;
        let isLoading = false;
        let messages = []; // { role: "user"|"model", text: string }

        function openChat() {
            isOpen = true;
            win.style.opacity = "1";
            win.style.transform = "scale(1) translateY(0)";
            win.style.pointerEvents = "auto";
            input.focus();
        }

        function closeChat() {
            isOpen = false;
            win.style.opacity = "0";
            win.style.transform = "scale(0.9) translateY(8px)";
            win.style.pointerEvents = "none";
        }

        toggle.addEventListener("click", () =>
            isOpen ? closeChat() : openChat()
        );
        closeBtn.addEventListener("click", closeChat);

        // Close on outside click
        document.addEventListener("click", (e) => {
            if (
                isOpen &&
                !win.contains(e.target) &&
                e.target !== toggle &&
                !toggle.contains(e.target)
            ) {
                closeChat();
            }
        });

        function appendMessage(role, text) {
            const isUser = role === "user";
            const div = document.createElement("div");
            div.className = `flex gap-2.5 items-start ${
                isUser ? "flex-row-reverse" : ""
            }`;

            const bubble = document.createElement("div");
            bubble.className = isUser
                ? "bg-cyan/20 border border-cyan/25 rounded-2xl rounded-tr-sm px-3.5 py-2.5 text-sm text-clean/90 leading-relaxed max-w-[85%]"
                : "prose prose-sm prose-invert prose-p:my-1 prose-ul:my-1 prose-a:text-cyan hover:prose-a:underline prose-strong:text-cyan bg-white/6 rounded-2xl rounded-tl-sm px-3.5 py-2.5 text-sm text-clean/90 leading-relaxed max-w-[85%]";

            if (isUser) {
                bubble.textContent = text;
            } else {
                // Render markdown for bot responses. We use a global function attached below.
                bubble.innerHTML = window.parseMarkdown
                    ? window.parseMarkdown(text)
                    : text;
            }

            if (!isUser) {
                const icon = document.createElement("span");
                icon.className = "text-base flex-shrink-0 mt-0.5";
                icon.textContent = "🐠";
                div.appendChild(icon);
            }
            div.appendChild(bubble);
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
            return bubble;
        }

        function showTyping() {
            const div = document.createElement("div");
            div.id = "nemo-typing";
            div.className = "flex gap-2.5 items-start";
            div.innerHTML = `<span class="text-base flex-shrink-0 mt-0.5">🐠</span>
            <div class="bg-white/6 rounded-2xl rounded-tl-sm px-4 py-3 flex gap-1 items-center">
                <span class="w-1.5 h-1.5 rounded-full bg-muted/60 animate-bounce" style="animation-delay:0ms"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-muted/60 animate-bounce" style="animation-delay:150ms"></span>
                <span class="w-1.5 h-1.5 rounded-full bg-muted/60 animate-bounce" style="animation-delay:300ms"></span>
            </div>`;
            messagesEl.appendChild(div);
            messagesEl.scrollTop = messagesEl.scrollHeight;
        }

        function removeTyping() {
            document.getElementById("nemo-typing")?.remove();
        }

        async function send(text) {
            if (!text.trim() || isLoading) return;
            isLoading = true;
            sendBtn.disabled = true;

            // Hide suggestions after first message
            if (messages.length === 0) {
                suggestionsEl.style.display = "none";
            }

            messages.push({ role: "user", text });
            appendMessage("user", text);
            input.value = "";
            showTyping();

            try {
                const res = await fetch("/api/chat", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ messages }),
                });
                const data = await res.json();
                removeTyping();

                const reply =
                    data.reply || data.error || "Sorry, something went wrong.";
                messages.push({ role: "model", text: reply });
                appendMessage("model", reply);
            } catch {
                removeTyping();
                appendMessage(
                    "model",
                    "I'm having trouble connecting. Please check your internet and try again."
                );
            } finally {
                isLoading = false;
                sendBtn.disabled = false;
                input.focus();
            }
        }

        sendBtn.addEventListener("click", () => send(input.value));
        input.addEventListener("keydown", (e) => {
            if (e.key === "Enter" && !e.shiftKey) {
                e.preventDefault();
                send(input.value);
            }
        });

        // Quick suggestion buttons
        document.querySelectorAll(".suggestion-btn").forEach((btn) => {
            btn.addEventListener("click", () => send(btn.textContent.trim()));
        });
    })();
</script>

<script>
    import { marked } from "marked";

    declare global {
        interface Window {
            parseMarkdown: (text: string) => string | Promise<string>;
        }
    }

    // Expose marked for the inline script to use
    window.parseMarkdown = (text) => marked.parse(text, { async: false });
</script>

<style is:global>
    #nemo-messages::-webkit-scrollbar {
        width: 4px;
    }
    #nemo-messages::-webkit-scrollbar-track {
        background: transparent;
    }
    #nemo-messages::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.1);
        border-radius: 2px;
    }
    #nemo-window {
        transition: opacity 0.2s ease, transform 0.2s ease;
    }
</style>
