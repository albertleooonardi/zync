---
interface ClickRow {
    clicked_at: string;
}

interface Props {
    /** All raw click rows — filtering happens client-side */
    clicks: ClickRow[];
    /** ISO string of when the link was created — used for "All time" range */
    linkCreatedAt: string;
    totalClicks: number;
}

const { clicks, linkCreatedAt, totalClicks } = Astro.props;
---

<div class="rounded-2xl bg-river border border-white/5 p-6 space-y-4">
    <!-- Header row: title left, click count + filter buttons right -->
    <div class="flex items-start justify-between flex-wrap gap-3">
        <div>
            <h2 class="text-base font-bold text-clean">Click Activity</h2>
            <p id="chart-range-label" class="text-xs text-muted mt-0.5">
                Last 30 days
            </p>
        </div>
        <div class="flex flex-col items-end gap-2">
            <p
                id="chart-total"
                class="text-2xl font-black text-cyan tabular-nums transition-all duration-300"
            >
                {totalClicks.toLocaleString()}
            </p>
            <p class="text-xs text-muted -mt-1">clicks in range</p>
        </div>
    </div>

    <!-- Filter pill buttons -->
    <div class="flex gap-1.5 flex-wrap">
        {
            [
                { key: "today", label: "Today" },
                { key: "7d", label: "7 Days" },
                { key: "30d", label: "30 Days" },
                { key: "all", label: "All Time" },
            ].map(({ key, label }) => (
                <button
                    type="button"
                    data-range={key}
                    class={`range-btn px-3.5 py-1.5 rounded-lg text-xs font-semibold transition-all duration-150 border ${
                        key === "30d"
                            ? "bg-cyan/15 border-cyan/40 text-cyan"
                            : "bg-white/5 border-white/10 text-muted hover:text-clean hover:border-white/20"
                    }`}
                >
                    {label}
                </button>
            ))
        }
    </div>

    <!-- Canvas -->
    <div class="relative h-56">
        <canvas id="clicksChart"></canvas>
    </div>
</div>

<!-- Pass click data + link creation date to client script via data element -->
<div
    id="chart-data"
    data-clicks={JSON.stringify(clicks.map((c) => c.clicked_at))}
    data-created={linkCreatedAt}
    hidden
></div>

<script>
    // ── Load Chart.js from CDN then initialise ────────────────────────────────
    const script = document.createElement("script");
    script.src =
        "https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js";
    document.head.appendChild(script);

    script.onload = () => {
        const el = document.getElementById("chart-data")!;
        const allTimestamps: string[] = JSON.parse(el.dataset.clicks ?? "[]");
        // linkCreated expressed as UTC midnight so comparisons are consistent
        const linkCreatedStr = el.dataset.created!.slice(0, 10); // "YYYY-MM-DD"

        // ── UTC helpers ────────────────────────────────────────────────────────
        /** Returns "YYYY-MM-DD" for a UTC date object */
        function utcKey(d: Date): string {
            return d.toISOString().slice(0, 10);
        }

        /** UTC midnight for a given UTC date string "YYYY-MM-DD" */
        function utcMidnight(iso: string): Date {
            const [y, m, day] = iso.split("-").map(Number);
            return new Date(Date.UTC(y, m - 1, day));
        }

        /** "Mar 1" style label from "YYYY-MM-DD" */
        function formatLabel(isoDate: string): string {
            return utcMidnight(isoDate).toLocaleDateString("en-US", {
                month: "short",
                day: "numeric",
                timeZone: "UTC",
            });
        }

        /** Today's UTC date key */
        function todayKey(): string {
            return utcKey(new Date());
        }

        /** N days ago UTC date key */
        function daysAgoKey(n: number): string {
            const d = new Date();
            d.setUTCDate(d.getUTCDate() - n);
            return utcKey(d);
        }

        /** Build a zero-filled map from `fromKey` to `toKey` (inclusive, UTC) */
        function buildDays(fromKey: string, toKey: string): Record<string, number> {
            const days: Record<string, number> = {};
            const cur = utcMidnight(fromKey);
            const end = utcMidnight(toKey);
            while (cur <= end) {
                days[utcKey(cur)] = 0;
                cur.setUTCDate(cur.getUTCDate() + 1);
            }
            return days;
        }

        /** Cap fromKey so it's never before the link was created */
        function capToCreation(fromKey: string): string {
            return fromKey < linkCreatedStr ? linkCreatedStr : fromKey;
        }

        function aggregateForRange(range: string): {
            labels: string[];
            values: number[];
            total: number;
            description: string;
        } {
            const today = todayKey();
            let fromKey: string;
            let description: string;

            if (range === "today") {
                fromKey = today;
                description = "Today";
            } else if (range === "7d") {
                fromKey = capToCreation(daysAgoKey(6));
                description =
                    fromKey === linkCreatedStr
                        ? `Since ${formatLabel(linkCreatedStr)}`
                        : "Last 7 days";
            } else if (range === "30d") {
                fromKey = capToCreation(daysAgoKey(29));
                description =
                    fromKey === linkCreatedStr
                        ? `Since ${formatLabel(linkCreatedStr)}`
                        : "Last 30 days";
            } else {
                // All time — always starts from link creation
                fromKey = linkCreatedStr;
                description = `Since ${formatLabel(linkCreatedStr)}`;
            }

            const days = buildDays(fromKey, today);
            let total = 0;

            for (const ts of allTimestamps) {
                const key = ts.slice(0, 10); // UTC date from ISO timestamp
                if (key in days) {
                    days[key]++;
                    total++;
                }
            }

            return {
                labels: Object.keys(days).map(formatLabel),
                values: Object.values(days),
                total,
                description,
            };
        }

        // ── Chart init ────────────────────────────────────────────────────────
        const ctx = (
            document.getElementById("clicksChart") as HTMLCanvasElement
        ).getContext("2d")!;

        const gradient = ctx.createLinearGradient(0, 0, 0, ctx.canvas.clientHeight || 224);
        gradient.addColorStop(0, "rgba(6, 182, 212, 0.25)");
        gradient.addColorStop(1, "rgba(6, 182, 212, 0)");

        const initial = aggregateForRange("30d");

        const chart = new (window as any).Chart(ctx, {
            type: "line",
            data: {
                labels: initial.labels,
                datasets: [
                    {
                        label: "Clicks",
                        data: initial.values,
                        borderColor: "#06B6D4",
                        borderWidth: 2,
                        backgroundColor: gradient,
                        fill: true,
                        tension: 0.4,
                        pointBackgroundColor: "#06B6D4",
                        pointBorderColor: "#0B0F19",
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 6,
                    },
                ],
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: "index", intersect: false },
                animation: { duration: 300 },
                plugins: {
                    legend: { display: false },
                    tooltip: {
                        backgroundColor: "#1E293B",
                        borderColor: "rgba(6,182,212,0.3)",
                        borderWidth: 1,
                        titleColor: "#94A3B8",
                        bodyColor: "#F8FAFC",
                        bodyFont: { weight: "bold" },
                        padding: 12,
                        cornerRadius: 10,
                    },
                },
                scales: {
                    x: {
                        grid: { color: "rgba(255,255,255,0.04)" },
                        ticks: {
                            color: "#64748B",
                            font: { size: 11 },
                            maxRotation: 0,
                            maxTicksLimit: 10,
                        },
                        border: { color: "transparent" },
                    },
                    y: {
                        beginAtZero: true,
                        grid: { color: "rgba(255,255,255,0.04)" },
                        ticks: {
                            color: "#64748B",
                            font: { size: 11 },
                            stepSize: 1,
                            callback: (val: number) =>
                                Number.isInteger(val) ? val : null,
                        },
                        border: { color: "transparent" },
                    },
                },
            },
        });

        // ── Filter buttons ────────────────────────────────────────────────────
        const totalEl = document.getElementById("chart-total");
        const labelEl = document.getElementById("chart-range-label");
        let activeRange = "30d";

        document
            .querySelectorAll<HTMLButtonElement>(".range-btn")
            .forEach((btn) => {
                btn.addEventListener("click", () => {
                    activeRange = btn.dataset.range!;

                    // Active styling
                    document
                        .querySelectorAll<HTMLButtonElement>(".range-btn")
                        .forEach((b) => {
                            b.classList.remove("bg-cyan/15", "border-cyan/40", "text-cyan");
                            b.classList.add("bg-white/5", "border-white/10", "text-muted");
                        });
                    btn.classList.remove("bg-white/5", "border-white/10", "text-muted");
                    btn.classList.add("bg-cyan/15", "border-cyan/40", "text-cyan");

                    updateChartUI();
                });
            });

        function updateChartUI() {
            const result = aggregateForRange(activeRange);
            chart.data.labels = result.labels;
            chart.data.datasets[0].data = result.values;
            chart.update();

            if (totalEl) totalEl.textContent = result.total.toLocaleString();
            if (labelEl) labelEl.textContent = result.description;
        }

        // Initial 30d view
        updateChartUI();

        // ── Live Realtime Updates ─────────────────────────────────────────────
        window.addEventListener("new-click", (e) => {
            const clickData = (e as CustomEvent).detail;
            if (clickData && clickData.clicked_at) {
                // Add the new timestamp to our raw data array
                allTimestamps.push(clickData.clicked_at);
                
                // Re-aggregate and update the chart for the currently selected range
                updateChartUI();
            }
        });
    };
</script>
