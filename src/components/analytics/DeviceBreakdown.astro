---
interface DeviceItem {
    name: string;
    count: number;
    percent: number;
}

interface Props {
    devices: DeviceItem[];
}

const { devices } = Astro.props;

const iconMap: Record<string, string> = {
    mobile: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 1.5H8.25A2.25 2.25 0 006 3.75v16.5a2.25 2.25 0 002.25 2.25h7.5A2.25 2.25 0 0018 20.25V3.75a2.25 2.25 0 00-2.25-2.25H13.5m-3 0V3h3V1.5m-3 0h3m-3 15.75h3" /></svg>`,
    desktop: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0H3" /></svg>`,
    tablet: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5h3m-6.75 2.25h10.5a2.25 2.25 0 002.25-2.25v-15a2.25 2.25 0 00-2.25-2.25H6.75A2.25 2.25 0 004.5 4.5v15a2.25 2.25 0 002.25 2.25z" /></svg>`,
    unknown: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9.879 7.519c1.171-1.025 3.071-1.025 4.242 0 1.172 1.025 1.172 2.687 0 3.712-.203.179-.43.326-.67.442-.745.361-1.45.999-1.45 1.827v.75M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-9 5.25h.008v.008H12v-.008z" /></svg>`,
};
---

<div class="rounded-2xl bg-river border border-white/5 p-5 space-y-4 h-full">
    <h3 class="text-sm font-bold text-clean">Devices</h3>

    {
        devices.length === 0 ? (
            <p class="text-xs text-muted/60 py-4 text-center">
                No device data yet.
            </p>
        ) : (
            <ul class="space-y-3">
                {devices.map((d) => (
                    <li class="flex items-center gap-3">
                        <div class="w-8 h-8 rounded-lg bg-cyan/10 border border-cyan/20 flex items-center justify-center text-cyan flex-shrink-0">
                            <Fragment
                                set:html={
                                    iconMap[d.name.toLowerCase()] ??
                                    iconMap.unknown
                                }
                            />
                        </div>
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center justify-between mb-1">
                                <span class="text-sm text-clean capitalize">
                                    {d.name}
                                </span>
                                <span class="text-xs tabular-nums text-muted">
                                    {d.count}{" "}
                                    <span class="text-muted/50">
                                        ({d.percent}%)
                                    </span>
                                </span>
                            </div>
                            <div class="h-1.5 w-full rounded-full bg-white/5 overflow-hidden">
                                <div
                                    class="h-full rounded-full bg-cyan transition-all duration-500"
                                    style={`width: ${d.percent}%`}
                                />
                            </div>
                        </div>
                    </li>
                ))}
            </ul>
        )
    }
</div>
