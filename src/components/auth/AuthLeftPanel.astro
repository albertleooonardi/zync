---
interface Props {
    /** Primary accent colour direction — "cyan" (login) or "pink" (register) */
    accent?: "cyan" | "pink";
}

const { accent = "cyan" } = Astro.props;

const gradientFrom = accent === "cyan" ? "from-cyan/20" : "from-pink/20";
const gradientTo = accent === "cyan" ? "to-pink/20" : "to-cyan/20";

const blobTop =
    accent === "cyan"
        ? "absolute top-0 left-0 w-[500px] h-[500px] rounded-full bg-cyan/10 blur-[120px] -translate-x-1/3 -translate-y-1/3"
        : "absolute top-0 right-0 w-[500px] h-[500px] rounded-full bg-pink/10 blur-[120px] translate-x-1/3 -translate-y-1/3";

const blobBottom =
    accent === "cyan"
        ? "absolute bottom-0 right-0 w-[400px] h-[400px] rounded-full bg-pink/10 blur-[100px] translate-x-1/3 translate-y-1/3"
        : "absolute bottom-0 left-0 w-[400px] h-[400px] rounded-full bg-cyan/10 blur-[100px] -translate-x-1/3 translate-y-1/3";

const gridColor = accent === "cyan" ? "#06B6D4" : "#EC4899";
---

<div
    class="hidden lg:flex lg:w-1/2 relative flex-col items-center justify-center p-12 overflow-hidden"
>
    <!-- Layered gradient background -->
    <div class="absolute inset-0 bg-[#0B0F19]"></div>
    <div
        class={`absolute inset-0 bg-gradient-to-br ${gradientFrom} via-transparent ${gradientTo}`}
    >
    </div>
    <div class={blobTop}></div>
    <div class={blobBottom}></div>

    <!-- Grid overlay -->
    <div
        class="absolute inset-0 opacity-[0.04]"
        style={`background-image: linear-gradient(${gridColor} 1px, transparent 1px), linear-gradient(90deg, ${gridColor} 1px, transparent 1px); background-size: 48px 48px;`}
    >
    </div>

    <!-- Content slot -->
    <div class="relative z-10 text-center space-y-6 max-w-sm">
        <a
            href="/"
            class="text-5xl font-black bg-gradient-to-r from-cyan to-pink bg-clip-text text-transparent block"
        >
            Zync
        </a>
        <slot />
    </div>
</div>
