---
interface NavItem {
    href: string;
    label: string;
    icon: string;
}

const items: NavItem[] = [
    {
        href: "#account",
        label: "Account Profile",
        icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0zM4.501 20.118a7.5 7.5 0 0114.998 0A17.933 17.933 0 0112 21.75c-2.676 0-5.216-.584-7.499-1.632z"/></svg>`,
    },
    {
        href: "#domains",
        label: "Custom Domains",
        icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 008.716-6.747M12 21a9.004 9.004 0 01-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 017.843 4.582M12 3a8.997 8.997 0 00-7.843 4.582m15.686 0A11.953 11.953 0 0112 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0121 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0112 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 013 12c0-1.605.42-3.113 1.157-4.418"/></svg>`,
    },
    {
        href: "#api",
        label: "Developer API",
        icon: `<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75L22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3l-4.5 16.5"/></svg>`,
    },
];
---

<nav class="space-y-1">
    {
        items.map((item) => (
            <a
                href={item.href}
                class="sidebar-link flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm text-muted hover:text-clean hover:bg-white/5 transition-all duration-150 group"
            >
                <span class="text-muted group-hover:text-cyan transition-colors">
                    <Fragment set:html={item.icon} />
                </span>
                {item.label}
            </a>
        ))
    }
</nav>

<script>
    // Highlight active section on scroll
    const links = document.querySelectorAll<HTMLAnchorElement>(".sidebar-link");
    const sections = ["account", "domains", "api"].map((id) =>
        document.getElementById(id)
    );

    function setActive() {
        let active = 0;
        sections.forEach((s, i) => {
            if (s && s.getBoundingClientRect().top <= 120) active = i;
        });
        links.forEach((l, i) => {
            l.classList.toggle("bg-white/5", i === active);
            l.classList.toggle("text-clean", i === active);
            l.classList.toggle("text-muted", i !== active);
        });
    }

    window.addEventListener("scroll", setActive, { passive: true });
    setActive();
</script>
