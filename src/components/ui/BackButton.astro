---
interface Props {
    /** Destination URL for the back link */
    href: string;
    /** Link label text (default: "Back") */
    label?: string;
}

const { href, label = "Back" } = Astro.props;
---

<a
    href={href}
    class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-clean transition-colors duration-150"
>
    <svg
        class="w-4 h-4"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        viewBox="0 0 24 24"
        aria-hidden="true"
    >
        <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M15 19l-7-7 7-7"
        ></path>
    </svg>
    {label}
</a>
