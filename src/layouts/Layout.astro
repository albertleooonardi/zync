---
import "../styles/global.css";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Zync — Sync Your Links. Track Your Growth.",
	description = "Zync — The ultimate URL shortener with smart analytics, deep linking, and AI-powered meta tags.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-midnight text-clean font-sans antialiased selection:bg-cyan/30 selection:text-cyan"
	>
		<slot />
	</body>
</html>
