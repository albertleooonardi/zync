---
import "../styles/global.css";
import NemoChat from "../components/NemoChat.astro";

import ConfirmModal from "../components/ui/ConfirmModal.astro";

interface Props {
	title?: string;
	description?: string;
}

const {
	title = "Zync — Sync Your Links. Track Your Growth.",
	description = "Zync — The ultimate URL shortener with smart analytics, deep linking, and AI-powered meta tags.",
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content={description} />
		<title>{title}</title>
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body
		class="bg-midnight text-clean font-sans antialiased selection:bg-cyan/30 selection:text-cyan"
	>
		<slot />
		
		<ConfirmModal />
		
		<!-- Global Toast Container -->
		<div id="global-toast-container" class="fixed bottom-6 right-6 z-[110] flex flex-col gap-2 pointer-events-none"></div>

		<NemoChat />

		<script is:inline>
			window.showToast = function(message, type = "success") {
				const container = document.getElementById("global-toast-container");
				if (!container) return;

				const toast = document.createElement("div");
				toast.className = `flex items-center gap-3 px-5 py-3.5 rounded-2xl border shadow-2xl text-sm font-medium transform transition-all duration-300 translate-y-10 opacity-0 pointer-events-auto max-w-sm ${
					type === "success" 
						? "bg-river border-cyan/30 text-clean shadow-cyan/20" 
						: type === "error"
						? "bg-river border-red-500/30 text-clean shadow-red-500/20"
						: "bg-river border-white/10 text-clean shadow-black/50"
				}`;

				let iconHtml = "";
				if (type === "success") {
					iconHtml = `<span class="w-6 h-6 rounded-full bg-cyan/15 flex items-center justify-center flex-shrink-0"><svg class="w-3.5 h-3.5 text-cyan" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7" /></svg></span>`;
				} else if (type === "error") {
					iconHtml = `<span class="w-6 h-6 rounded-full bg-red-500/15 flex items-center justify-center flex-shrink-0"><svg class="w-3.5 h-3.5 text-red-500" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" /></svg></span>`;
				} else {
					iconHtml = `<span class="w-6 h-6 rounded-full bg-white/10 flex items-center justify-center flex-shrink-0"><svg class="w-3.5 h-3.5 text-muted" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg></span>`;
				}

				toast.innerHTML = `
					${iconHtml}
					<p class="flex-1">${message}</p>
					<button class="toast-close ml-2 text-muted hover:text-clean transition-colors">
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
							<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
						</svg>
					</button>
				`;

				container.appendChild(toast);

				// Animate in
				requestAnimationFrame(() => {
					toast.classList.remove("translate-y-10", "opacity-0");
				});

				const removeToast = () => {
					toast.classList.add("translate-y-10", "opacity-0");
					setTimeout(() => toast.remove(), 300);
				};

				toast.querySelector(".toast-close").addEventListener("click", removeToast);
				setTimeout(removeToast, 4000);
			};
		</script>
	</body>
</html>
