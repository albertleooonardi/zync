---
// POST /api/ai-meta
// Body: { url: string, title: string, description: string }
// Returns: { title: string, description: string } improved by Ollama
import { generate, isAvailable } from "../../lib/groq";

if (Astro.request.method !== "POST") {
    return new Response(JSON.stringify({ error: "Method not allowed" }), {
        status: 405,
        headers: { "Content-Type": "application/json" },
    });
}

let body: { url?: string; title?: string; description?: string };
try {
    body = await Astro.request.json();
} catch {
    return new Response(JSON.stringify({ error: "Invalid JSON body" }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
    });
}

const { url = "", title = "", description = "" } = body;

if (!isAvailable()) {
    return new Response(
        JSON.stringify({ error: "GROQ_AI_API_KEY is not set." }),
        { status: 503, headers: { "Content-Type": "application/json" } }
    );
}

const prompt = `You are an expert, highly-engaging social media copywriter. Improve the og:title and og:description for this link so it gets MAXIMUM clicks when shared on WhatsApp, Twitter, and Instagram.

URL: ${url}
Current title: ${title || "(none)"}
Current description: ${description || "(none)"}

Rules:
- Title: max 60 characters, catchy and clear, no quotes. Use 1 relevant emoji.
- Description: Write a detailed, highly engaging description (around 2-3 sentences, 200-300 characters). Make it irresistible to click! Use 2-3 relevant emojis to make it pop! No quotes.
- Keep the language matching the original (if Indonesian, stay Indonesian)
- Provide ONLY a JSON object with "title" and "description" keys.`;

try {
    const responseText = await generate(prompt, undefined, {
        responseMimeType: "application/json",
        maxOutputTokens: 400,
    });

    // With responseMimeType: application/json, it should be natively parseable
    let improved;
    try {
        improved = JSON.parse(responseText);
    } catch {
        return new Response(
            JSON.stringify({
                error: "AI returned invalid JSON structure.",
                details: responseText,
            }),
            { status: 422, headers: { "Content-Type": "application/json" } }
        );
    }

    // Fallback validation
    if (!improved.title || !improved.description) {
        return new Response(
            JSON.stringify({
                error: "AI JSON missing title or description.",
                details: responseText,
            }),
            { status: 422, headers: { "Content-Type": "application/json" } }
        );
    }

    return new Response(JSON.stringify(improved), {
        status: 200,
        headers: { "Content-Type": "application/json" },
    });
} catch (err) {
    return new Response(JSON.stringify({ error: (err as Error).message }), {
        status: 500,
        headers: { "Content-Type": "application/json" },
    });
}
