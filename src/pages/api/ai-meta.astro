---
// POST /api/ai-meta
// Body: { url: string, title: string, description: string }
// Returns: { title: string, description: string } improved by Ollama
import { generate, isAvailable } from "../../lib/gemini";

if (Astro.request.method !== "POST") {
    return new Response(JSON.stringify({ error: "Method not allowed" }), {
        status: 405,
        headers: { "Content-Type": "application/json" },
    });
}

let body: { url?: string; title?: string; description?: string };
try {
    body = await Astro.request.json();
} catch {
    return new Response(JSON.stringify({ error: "Invalid JSON body" }), {
        status: 400,
        headers: { "Content-Type": "application/json" },
    });
}

const { url = "", title = "", description = "" } = body;

if (!isAvailable()) {
    return new Response(
        JSON.stringify({ error: "GOOGLE_AI_API_KEY is not set. Get a free key at https://aistudio.google.com/app/apikey" }),
        { status: 503, headers: { "Content-Type": "application/json" } }
    );
}

const prompt = `You are a social media copywriter. Improve the og:title and og:description for this link so it gets more clicks when shared on WhatsApp, Twitter, and Instagram.

URL: ${url}
Current title: ${title || "(none)"}
Current description: ${description || "(none)"}

Rules:
- Title: max 60 characters, catchy and clear, no quotes
- Description: max 155 characters, compelling but honest, no quotes
- Keep the language matching the original (if Indonesian, stay Indonesian)
- Reply ONLY in this exact JSON format, nothing else:
{"title":"...", "description":"..."}`;

try {
    const response = await generate(prompt);
    // Extract JSON from the response (model may add extra text)
    const jsonMatch = response.match(/\{"title"[\s\S]*?\}/);
    if (!jsonMatch) {
        return new Response(
            JSON.stringify({ error: "Could not parse AI response. Try again." }),
            { status: 422, headers: { "Content-Type": "application/json" } }
        );
    }
    const improved = JSON.parse(jsonMatch[0]);
    return new Response(JSON.stringify(improved), {
        status: 200,
        headers: { "Content-Type": "application/json" },
    });
} catch (err) {
    return new Response(
        JSON.stringify({ error: (err as Error).message }),
        { status: 500, headers: { "Content-Type": "application/json" } }
    );
}
