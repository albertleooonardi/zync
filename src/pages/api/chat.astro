---
// POST /api/chat
// Body: { messages: [{ role: "user"|"model", text: string }] }
// Returns: { reply: string }
export const prerender = false;

import { generateWithTools } from "../../lib/groq";
import { createSupabaseAdminClient } from "../../lib/supabase";
import { createClient } from "@supabase/supabase-js";

if (Astro.request.method !== "POST") {
    return new Response(JSON.stringify({ error: "Method not allowed" }), {
        status: 405,
        headers: { "Content-Type": "application/json" },
    });
}

let body: { messages?: Array<{ role: string; text: string }> };
try {
    body = await Astro.request.json();
} catch {
    return new Response(JSON.stringify({ error: "Invalid JSON" }), {
        status: 400,
    });
}

const reqMessages = body.messages ?? [];
const userMessage = reqMessages[reqMessages.length - 1]?.text ?? "";

if (!userMessage.trim()) {
    return new Response(JSON.stringify({ error: "Empty message" }), {
        status: 400,
    });
}

// Ensure user is authenticated to perform agentic actions on their behalf
const supabase = createSupabaseAdminClient();
// We need the user's cookie to get their session
const authFallback = Astro.cookies.get("sb-access-token")?.value;

let userId: string | null = null;

// Try to get user from token in cookies directly using Supabase anon client flow
const supaAnon = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL,
    import.meta.env.PUBLIC_SUPABASE_ANON_KEY,
    { auth: { persistSession: false } }
);

if (authFallback) {
    const { data } = await supaAnon.auth.getUser(authFallback);
    userId = data.user?.id || null;
}

const tools = [
    {
        type: "function",
        function: {
            name: "create_link",
            description:
                "Create a new shortened Zync link for the user. Call this when the user asks you to shorten a URL.",
            parameters: {
                type: "object",
                properties: {
                    original_url: {
                        type: "string",
                        description:
                            "The full destination URL (must start with http:// or https://)",
                    },
                    alias: {
                        type: "string",
                        description:
                            "Optional custom short alias (e.g. 'my-promo'). Leave empty for auto-generated.",
                    },
                },
                required: ["original_url"],
            },
        },
    },
    {
        type: "function",
        function: {
            name: "get_link_stats",
            description:
                "Get the current analytics summary (clicks, creation date, top devices) for a specific shortened link.",
            parameters: {
                type: "object",
                properties: {
                    alias: {
                        type: "string",
                        description:
                            "The short alias of the link to fetch stats for (e.g. 'my-promo')",
                    },
                },
                required: ["alias"],
            },
        },
    },
];

// Build history context (last 4 turns limit)
const history = reqMessages.slice(-5, -1).map((m) => ({
    role: m.role === "user" ? "user" : "assistant",
    content: m.text,
}));

const systemPrompt = `You are **Nemo** 🐠, Zync's friendly, enthusiastic, and highly interactive AI assistant! You live inside the Zync URL shortener platform and your sole goal is to make users feel empowered and excited about using Zync.

## Your Personality
You are warm, incredibly encouraging, and fun — like a knowledgeable friend who happens to be a tech expert. You use emojis generously (but naturally) to make conversations feel vibrant and alive! 🌟 
Give detailed, helpful, and slightly longer answers that leave users completely confident in what to do next. Never give a brief one-liner; always expand a bit to show enthusiasm and provide a clear explanation or a quick example! 🚀

## Your Tools
You have two special superpowers you can use for logged-in users:
1. **create_link** 🔗 — Shorten a URL instantly. Use this right away when the user asks to shorten something!
2. **get_link_stats** 📊 — Pull up live analytics for any of the user's short links.

## Response Style
- **Use Markdown** — bold, bullet lists, and \`code spans\` where helpful. Separate distinct points with paragraph breaks.
- **Use Emojis** naturally and frequently! 🎉 Include ones that express excitement, clarity, and tech-savviness. 💻✨
- **Length & Pace** — aim for 2–4 descriptive paragraphs. Make the response feel rich and conversational. Take the time to explain the 'why' and 'how'.
- **Paragraph breaks matter** — whenever you write more than one idea, put each on its own paragraph with a blank line between them so the chat is easy to read.
- **End with Engagement** — always wrap up with a friendly, inviting follow-up question or an offer to explore another feature! 🤔💬

## Zync Features (know these deeply!)
- 🔀 **A/B Routing** — Split traffic between two URLs (e.g., 50/50 or 70/30) to test which landing page converts better. Perfect for marketers running experiments!
- ⏰ **Time-Based Routing** — Send visitors to different URLs depending on the time or day. Great for flash sales, events, or timezone-specific campaigns.
- 📱 **Device/OS Routing** — Automatically send iOS users to the App Store, Android users to the Play Store, and desktop visitors to your website. One smart link for all platforms!
- 🌍 **Geo-Routing** — Redirect visitors based on their country. Perfect for international campaigns or serving region-specific content.
- 🤖 **Meta-Tag Optimizer** — AI generates optimized OpenGraph titles, descriptions, and images so your link previews look stunning on WhatsApp, Twitter, Instagram, and more.
- 🛡️ **Phishing Shield** — Zync auto-scans URLs with AI to block malicious or spammy links from ever being shortened.
- 🔒 **Password Protection** — Lock sensitive links so only people with the password can access the destination.
- 🏷️ **Custom Aliases** — Create memorable, branded short links like \`zync.id/my-campaign\` instead of random characters.
- 📊 **In-Depth Analytics** — Track every click with data on referrers, devices, OS, and countries. Beautiful real-time charts!

## Conversation Context
${history.length > 0 ? "Recent messages:\n" + history.map(h => `${h.role}: ${h.content}`).join("\n") : "(This is the start of our conversation — give a warm intro if appropriate! 👋)"}`;

// 1. Initial request to Groq
const groqMessages: any[] = [
    { role: "system", content: systemPrompt },
    ...history,
    { role: "user", content: userMessage },
];

try {
    let message = await generateWithTools(groqMessages, tools);

    // 2. If Groq wants to call a tool
    if (message.tool_calls && message.tool_calls.length > 0) {
        const call = message.tool_calls[0];
        const args = JSON.parse(call.function.arguments || "{}");
        let result: any = {};

        // ----------------------------------------------------
        // TOOL PRE-CHECK: User must be signed in
        // ----------------------------------------------------
        if (!userId) {
            result = {
                error: "User is not signed in. Tell them they need to log in to use agentic features.",
            };
        }

        // ----------------------------------------------------
        // TOOL: create_link
        // ----------------------------------------------------
        else if (call.name === "create_link") {
            try {
                // Ensure protocol
                let url = args.original_url;
                if (!url.startsWith("http://") && !url.startsWith("https://")) {
                    url = "https://" + url;
                }

                // Fallback alias generation
                let alias = args.alias;
                if (!alias) {
                    const crypto = await import("crypto");
                    alias = crypto.randomBytes(3).toString("hex");
                }

                const { error } = await supabase.from("links").insert({
                    user_id: userId,
                    alias,
                    original_url: url,
                });

                if (error) {
                    if (error.code === "23505")
                        result = { error: "Alias is already taken." };
                    else result = { error: error.message };
                } else {
                    const siteUrl = import.meta.env.PUBLIC_SITE_URL || new URL(Astro.request.url).origin;
                    result = {
                        success: true,
                        short_url: `${siteUrl}/${alias}`,
                        message: "Link created successfully!",
                    };
                }
            } catch (err: any) {
                result = { error: err.message };
            }
        }

        // ----------------------------------------------------
        // TOOL: get_link_stats
        // ----------------------------------------------------
        else if (call.name === "get_link_stats") {
            try {
                // 1. Get the link to verify ownership and get ID
                const { data: link, error: linkErr } = await supabase
                    .from("links")
                    .select("id, original_url, created_at, clicks_count")
                    .eq("alias", args.alias)
                    .eq("user_id", userId)
                    .single();

                if (linkErr || !link) {
                    result = {
                        error: "Link not found or user does not own this link.",
                    };
                } else {
                    // 2. Get click details
                    const { data: clicks } = await supabase
                        .from("clicks")
                        .select("*")
                        .eq("link_id", link.id);

                    const clickList = clicks || [];
                    result = {
                        success: true,
                        alias: args.alias,
                        destination: link.original_url,
                        created_on: link.created_at,
                        total_clicks: clickList.length,
                        // quick aggregation
                        devices: clickList.reduce(
                            (acc, c) => ({
                                ...acc,
                                [c.device || "unknown"]:
                                    (acc[c.device || "unknown"] || 0) + 1,
                            }),
                            {}
                        ),
                        countries: clickList.reduce(
                            (acc, c) => ({
                                ...acc,
                                [c.country || "unknown"]:
                                    (acc[c.country || "unknown"] || 0) + 1,
                            }),
                            {}
                        ),
                    };
                }
            } catch (err: any) {
                result = { error: err.message };
            }
        }

        // 3. Send the tool result back to Groq so it can answer the user natively
        groqMessages.push(message);
        groqMessages.push({
            role: "tool",
            tool_call_id: call.id,
            name: call.function.name,
            content: JSON.stringify(result),
        });

        message = await generateWithTools(groqMessages, []); // Empty tools array on second turn
    }

    // 4. Return final text response
    return new Response(JSON.stringify({ reply: message.content || "Done." }), {
        status: 200,
        headers: { "Content-Type": "application/json" },
    });
} catch (err) {
    return new Response(JSON.stringify({ error: (err as Error).message }), {});
}
