---
import { createClient } from "@supabase/supabase-js";
import Stripe from "stripe";

// Initialize Supabase Admin strictly for backend API
const supabase = createClient(
    import.meta.env.PUBLIC_SUPABASE_URL || "",
    import.meta.env.SUPABASE_SERVICE_ROLE_KEY || import.meta.env.PUBLIC_SUPABASE_ANON_KEY || ""
);

// Only allow POST requests for checkout
if (Astro.request.method !== "POST") {
    return new Response(JSON.stringify({ error: "Method not allowed" }), {
        status: 405,
        headers: { "Content-Type": "application/json" }
    });
}

try {
    const { plan } = await Astro.request.json();

    if (!plan || (plan !== "creator" && plan !== "business")) {
        return new Response(JSON.stringify({ error: "Invalid plan selected" }), {
            status: 400,
            headers: { "Content-Type": "application/json" }
        });
    }

    // Determine price based on plan (in USD cents: $9 and $29)
    const gross_amount = plan === "creator" ? 900 : 2900;

    // Check Authentication
    const { data: { user }, error: authError } = await supabase.auth.getUser();

    // If not logged in, we can either return an error or allow guest checkout. 
    // Usually for SaaS, require login first. For now, we'll allow an anonymous identifier if no user.
    const userId = user?.id || `guest-${Date.now()}`;
    const email = user?.email || "guest@example.com";
    const firstName = user?.user_metadata?.first_name || "Zync";
    const lastName = user?.user_metadata?.last_name || "User";

    // Initialize Stripe API
    const stripe = new Stripe(import.meta.env.STRIPE_SECRET_KEY || 'sk_test_XXXXX');

    // Create unique order ID
    const orderId = `zync-${plan}-${userId.substring(0,8)}-${Date.now()}`;

    // Create checkout session
    const session = await stripe.checkout.sessions.create({
        payment_method_types: ['card'],
        customer_email: email,
        client_reference_id: userId,
        line_items: [{
            price_data: {
                currency: 'usd',
                product_data: {
                    name: `Zync ${plan.charAt(0).toUpperCase() + plan.slice(1)} Plan (1 Month)`,
                },
                unit_amount: gross_amount, // Amount in USD cents
            },
            quantity: 1,
        }],
        mode: 'payment',
        success_url: `${import.meta.env.PUBLIC_APP_URL || 'http://localhost:4321'}/dashboard?payment_success=true&order_id=${orderId}`,
        cancel_url: `${import.meta.env.PUBLIC_APP_URL || 'http://localhost:4321'}/pricing?payment_failed=true&order_id=${orderId}`,
        metadata: {
             userId: userId,
             plan: plan
        }
    });

    return new Response(JSON.stringify({ 
        url: session.url,
        order_id: orderId
    }), {
        status: 200,
        headers: { "Content-Type": "application/json" }
    });

} catch (error: any) {
    console.error("Checkout Error:", error);
    return new Response(JSON.stringify({ 
        error: "Failed to create transaction", 
        details: error.message 
    }), {
        status: 500,
        headers: { "Content-Type": "application/json" }
    });
}
---
