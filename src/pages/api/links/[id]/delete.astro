---
export const prerender = false;

import { createSupabaseServerClient } from "../../../../lib/supabase";

if (Astro.request.method !== "POST") {
    return new Response(JSON.stringify({ error: "Method not allowed" }), { status: 405 });
}

const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user }, error: authError } = await supabase.auth.getUser();

if (authError || !user) {
    return new Response(JSON.stringify({ error: "Unauthorized" }), { status: 401 });
}

const { id } = Astro.params;

if (!id) {
    return new Response(JSON.stringify({ error: "Missing link ID" }), { status: 400 });
}

// Delete from the database (RLS or matching user_id ensures they only delete their own)
const { error } = await supabase
    .from("links")
    .delete()
    .eq("id", id)
    .eq("user_id", user.id);

if (error) {
    return new Response(JSON.stringify({ error: error.message }), { status: 500 });
}

return Astro.redirect("/dashboard");
---
