---
import Layout from "../layouts/Layout.astro";
import { createSupabaseAdminClient, createSupabaseServerClient } from "../lib/supabase";
import { sendVerificationEmail } from "../lib/email";

const email = Astro.url.searchParams.get("email") ?? "";
let errorMessage = "";
let resendError = "";
let resendSuccess = "";

// Cooldown schedule (in ms) based on how many codes have already been sent
// 1st resend=2min, 2nd=4min, 3rd=16min, 4th+=60min
const COOLDOWNS = [2, 4, 16, 60].map((m) => m * 60 * 1000);

function getCooldownMs(sendCount: number): number {
    const idx = Math.min(sendCount - 1, COOLDOWNS.length - 1);
    return COOLDOWNS[Math.max(idx, 0)];
}

// Compute cooldown state for THIS email to show in UI
let nextAllowedAt: number | null = null; // epoch ms, null = can resend now

async function loadCooldownState(adminClient: ReturnType<typeof createSupabaseAdminClient>) {
    const { data: rows } = await adminClient
        .from("email_verifications")
        .select("created_at")
        .eq("email", email)
        .order("created_at", { ascending: false });

    if (!rows || rows.length === 0) return;

    const sendCount = rows.length;                         // how many codes sent so far
    const lastSentAt = new Date(rows[0].created_at).getTime();
    const cooldown = getCooldownMs(sendCount);
    const next = lastSentAt + cooldown;

    if (Date.now() < next) {
        nextAllowedAt = next;
    }
}

if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const action = formData.get("action")?.toString();
    const formEmail = formData.get("email")?.toString().trim() ?? "";

    // ── Resend code ───────────────────────────────────────────────
    if (action === "resend") {
        const admin = createSupabaseAdminClient();
        const { data: rows } = await admin
            .from("email_verifications")
            .select("created_at")
            .eq("email", formEmail)
            .order("created_at", { ascending: false });

        const sendCount = rows?.length ?? 0;

        if (sendCount > 0) {
            const lastSentAt = new Date(rows![0].created_at).getTime();
            const cooldown = getCooldownMs(sendCount);
            const next = lastSentAt + cooldown;

            if (Date.now() < next) {
                nextAllowedAt = next;
                resendError = "Please wait before requesting another code.";
            }
        }

        if (!resendError) {
            const code = String(Math.floor(100000 + Math.random() * 900000));
            await admin.from("email_verifications").insert({
                email: formEmail,
                code,
                expires_at: new Date(Date.now() + 3 * 60 * 1000).toISOString(),
            });

            try {
                await sendVerificationEmail(formEmail, code);
                resendSuccess = "A new code has been sent to your email.";
                // Recompute cooldown after new send
                const newSendCount = (rows?.length ?? 0) + 1;
                nextAllowedAt = Date.now() + getCooldownMs(newSendCount);
            } catch {
                resendError = "Failed to send email. Please try again in a moment.";
            }
        }

    // ── Verify code ───────────────────────────────────────────────
    } else {
        const inputCode = formData.get("code")?.toString().trim() ?? "";

        if (!inputCode || !formEmail) {
            errorMessage = "Please enter your verification code.";
        } else {
            const admin = createSupabaseAdminClient();
            const { data, error: dbError } = await admin
                .from("email_verifications")
                .select("*")
                .eq("email", formEmail)
                .eq("code", inputCode)
                .eq("used", false)
                .gt("expires_at", new Date().toISOString())
                .order("created_at", { ascending: false })
                .limit(1)
                .single();

            if (dbError || !data) {
                errorMessage = "Invalid or expired code. Please try again.";
                await loadCooldownState(createSupabaseAdminClient());
            } else {
                await admin
                    .from("email_verifications")
                    .update({ used: true })
                    .eq("id", data.id);

                // Auto-sign-in via magic link generation
                const { data: linkData, error: linkError } =
                    await admin.auth.admin.generateLink({
                        type: "magiclink",
                        email: formEmail,
                    });

                if (!linkError && linkData?.properties?.hashed_token) {
                    const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
                    await supabase.auth.verifyOtp({
                        token_hash: linkData.properties.hashed_token,
                        type: "magiclink",
                    });
                }

                return Astro.redirect("/dashboard");
            }
        }
    }
} else {
    // GET — load cooldown state for display
    if (email) {
        await loadCooldownState(createSupabaseAdminClient());
    }
}
---

<Layout
    title="Verify Your Email — Zync"
    description="Enter your 6-digit verification code to activate your Zync account."
>
    <!-- Top-left logo -->
    <a
        href="/"
        class="fixed top-5 left-6 z-50 text-2xl font-black bg-gradient-to-r from-cyan to-pink bg-clip-text text-transparent hover:opacity-80 transition-opacity"
    >
        Zync
    </a>

    <div class="min-h-screen flex items-center justify-center bg-[#0B0F19] px-6 py-16">
        <div class="w-full max-w-md space-y-8">

            <!-- Icon + Heading -->
            <div class="flex flex-col items-center text-center space-y-4">
                <div class="w-16 h-16 rounded-2xl bg-cyan/10 border border-cyan/20 flex items-center justify-center">
                    <svg class="w-8 h-8 text-cyan" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 01-2.25 2.25h-15a2.25 2.25 0 01-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0019.5 4.5h-15a2.25 2.25 0 00-2.25 2.25m19.5 0v.243a2.25 2.25 0 01-1.07 1.916l-7.5 4.615a2.25 2.25 0 01-2.36 0L3.32 8.91a2.25 2.25 0 01-1.07-1.916V6.75" />
                    </svg>
                </div>
                <div>
                    <h1 class="text-3xl font-black text-clean">Check your email</h1>
                    <p class="text-sm text-muted mt-2">
                        We sent a 6-digit code to
                        {email
                            ? <span class="text-cyan font-semibold">{email}</span>
                            : "your email address"
                        }.
                        <br />Enter it below to verify your account.
                    </p>
                </div>
            </div>

            <!-- Verify error -->
            {errorMessage && (
                <div class="flex items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                    </svg>
                    {errorMessage}
                </div>
            )}

            <!-- OTP Form -->
            <form method="POST" class="space-y-5" novalidate>
                <input type="hidden" name="email" value={email} />

                <div class="space-y-1.5">
                    <label for="code" class="block text-sm font-medium text-clean">
                        Verification code
                    </label>
                    <input
                        id="code"
                        name="code"
                        type="text"
                        inputmode="numeric"
                        pattern="[0-9]{6}"
                        maxlength="6"
                        required
                        autocomplete="one-time-code"
                        placeholder="000000"
                        class="w-full px-4 py-4 rounded-xl bg-river border border-white/10 text-clean text-center text-2xl font-bold tracking-[0.5em] placeholder:text-muted/30 placeholder:tracking-[0.5em] outline-none focus:border-cyan/60 focus:ring-2 focus:ring-cyan/20 transition-all duration-200"
                    />
                    <p class="text-xs text-muted/60 mt-1">Code expires in 3 minutes.</p>
                </div>

                <button
                    type="submit"
                    class="w-full py-3.5 bg-cyan hover:bg-cyan/90 text-midnight font-bold rounded-xl text-sm transition-all duration-150 active:scale-[0.98] shadow-[0_0_20px_rgba(6,182,212,0.35)] hover:shadow-[0_0_32px_rgba(6,182,212,0.55)]"
                >
                    Verify Email
                </button>
            </form>

            <!-- Resend section -->
            <div class="border-t border-white/5 pt-6 space-y-3">
                <p class="text-center text-sm text-muted">Didn't receive the code?</p>

                <!-- Resend success -->
                {resendSuccess && (
                    <div class="flex items-center gap-3 rounded-xl border border-green-500/30 bg-green-500/10 px-4 py-3 text-sm text-green-400">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd" />
                        </svg>
                        {resendSuccess}
                    </div>
                )}

                <!-- Resend error -->
                {resendError && !nextAllowedAt && (
                    <div class="flex items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                        <svg class="w-4 h-4 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
                            <path fill-rule="evenodd" d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z" clip-rule="evenodd" />
                        </svg>
                        {resendError}
                    </div>
                )}

                <!-- Cooldown countdown (shown when nextAllowedAt is set) -->
                {nextAllowedAt && (
                    <div id="cooldown-box" class="rounded-xl border border-white/10 bg-white/5 px-4 py-3 text-center">
                        <p class="text-xs text-muted mb-1">You can request a new code in</p>
                        <p id="countdown" class="text-lg font-bold text-cyan tabular-nums">—</p>
                    </div>
                )}

                <!-- Resend form -->
                <form method="POST" id="resend-form">
                    <input type="hidden" name="email" value={email} />
                    <input type="hidden" name="action" value="resend" />
                    <button
                        id="resend-btn"
                        type="submit"
                        disabled={!!nextAllowedAt}
                        class="w-full py-3 rounded-xl border border-white/10 text-sm font-semibold text-muted hover:text-clean hover:border-white/20 transition-all duration-150 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:text-muted disabled:hover:border-white/10"
                    >
                        Send a new code
                    </button>
                </form>
            </div>

        </div>
    </div>

    <!-- Countdown script -->
    {nextAllowedAt && (
        <script define:vars={{ nextAllowedAt }}>
            const btn = document.getElementById("resend-btn");
            const countdownEl = document.getElementById("countdown");
            const cooldownBox = document.getElementById("cooldown-box");

            function formatMs(ms) {
                if (ms <= 0) return "0:00";
                const totalSecs = Math.ceil(ms / 1000);
                const mins = Math.floor(totalSecs / 60);
                const secs = totalSecs % 60;
                return `${mins}:${String(secs).padStart(2, "0")}`;
            }

            function tick() {
                const remaining = nextAllowedAt - Date.now();
                if (remaining <= 0) {
                    cooldownBox.style.display = "none";
                    btn.disabled = false;
                    return;
                }
                countdownEl.textContent = formatMs(remaining);
                setTimeout(tick, 500);
            }

            tick();
        </script>
    )}
</Layout>
