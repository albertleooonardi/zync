---
import Layout from "../../layouts/Layout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";
import BackButton from "../../components/ui/BackButton.astro";
import { checkUrl } from "../../lib/phishing";

// ── Auth ──────────────────────────────────────────────────────────────────────
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user }, error: authError } = await supabase.auth.getUser();
if (authError || !user) return Astro.redirect("/login");

// ── Helpers ───────────────────────────────────────────────────────────────────
function randomAlias(len = 6): string {
    const chars = "abcdefghijkmnopqrstuvwxyz23456789";
    return Array.from(
        { length: len },
        () => chars[Math.floor(Math.random() * chars.length)]
    ).join("");
}

function isValidUrl(str: string): boolean {
    try {
        const url = new URL(str);
        return url.protocol === "http:" || url.protocol === "https:";
    } catch {
        return false;
    }
}

// ── Form state ────────────────────────────────────────────────────────────────
let errorMessage = "";
let fieldErrors: Record<string, string> = {};
let formValues = { original_url: "", alias: "" };
const suggestedAlias = randomAlias();
const siteHost = (import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/^https?:\/\//, "");
const displayHost = (import.meta.env.PUBLIC_DISPLAY_URL || import.meta.env.PUBLIC_SITE_URL || Astro.url.origin).replace(/^https?:\/\//, "");

// ── POST handler ──────────────────────────────────────────────────────────────
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const originalUrl = formData.get("original_url")?.toString().trim() ?? "";
    const rawAlias    = formData.get("alias")?.toString().trim() ?? "";
    const finalAlias  = rawAlias || suggestedAlias;

    // Smart feature fields
    const ogTitle       = formData.get("og_title")?.toString().trim() || null;
    const ogDescription = formData.get("og_description")?.toString().trim() || null;
    const ogImage       = formData.get("og_image")?.toString().trim() || null;
    const abUrlB        = formData.get("ab_url_b")?.toString().trim() || null;
    const abWeight      = parseInt(formData.get("ab_weight")?.toString() ?? "50", 10);
    const timeRulesRaw  = formData.get("time_rules")?.toString().trim() || null;
    let timeRules = null;
    if (timeRulesRaw) {
        try { timeRules = JSON.parse(timeRulesRaw); } catch { /* ignore invalid JSON */ }
    }

    formValues = { original_url: originalUrl, alias: rawAlias };

    // ── Validate
    if (!originalUrl) {
        fieldErrors.original_url = "Please enter a destination URL.";
    } else if (!isValidUrl(originalUrl)) {
        fieldErrors.original_url =
            "Must be a valid URL starting with http:// or https://";
    }
    if (rawAlias && !/^[a-zA-Z0-9_-]{2,50}$/.test(rawAlias)) {
        fieldErrors.alias =
            "Only letters, numbers, hyphens and underscores (2–50 chars).";
    }

    if (Object.keys(fieldErrors).length === 0) {
        // ── Phishing Shield ──────────────────────────────────────────────────
        const safety = await checkUrl(originalUrl);
        if (!safety.safe) {
            fieldErrors.original_url = `🛡️ Blocked: ${safety.reason}`;
        }
    }

    if (Object.keys(fieldErrors).length === 0) {
        const { error: dbError } = await supabase.from("links").insert({
            user_id:        user.id,
            alias:          finalAlias,
            original_url:   originalUrl,
            og_title:       ogTitle,
            og_description: ogDescription,
            og_image:       ogImage,
            ab_url_b:       abUrlB,
            ab_weight:      abWeight,
            time_rules:     timeRules,
        });

        if (dbError) {
            // Postgres unique violation on alias
            if (dbError.code === "23505") {
                fieldErrors.alias =
                    "That alias is already taken. Try a different one.";
            } else {
                errorMessage = dbError.message;
            }
        } else {
            return Astro.redirect(`/dashboard/new/created?alias=${encodeURIComponent(finalAlias)}`);
        }
    }
}
---

<Layout title="Create New Link — Zync" description="Shorten a URL with Zync.">
    <DashboardNav userEmail={user.email} />

    <main class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12 space-y-8">
        <!-- Header -->
        <div class="space-y-1">
            <BackButton href="/dashboard" label="Back to Dashboard" />
            <h1 class="text-3xl font-black text-clean">✨ Create New Zync</h1>
            <p class="text-sm text-muted">
                Shorten a URL and start tracking clicks instantly.
            </p>
        </div>

        <!-- Global error -->
        {
            errorMessage && (
                <div class="flex items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    <svg
                        class="w-4 h-4 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    {errorMessage}
                </div>
            )
        }

        <!-- Form card -->
        <div class="rounded-2xl bg-river border border-white/5 p-7 space-y-6">
            <form method="POST" class="space-y-6" novalidate id="new-link-form">
                <!-- Destination URL -->
                <div class="space-y-1.5">
                    <label
                        for="original_url"
                        class="block text-sm font-medium text-clean"
                    >
                        Destination URL <span class="text-red-400">*</span>
                    </label>
                    <div class="relative">
                        <div
                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4"
                        >
                            <svg
                                class="w-4 h-4 text-muted"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                ></path>
                            </svg>
                        </div>
                        <input
                            id="original_url"
                            name="original_url"
                            type="url"
                            required
                            value={formValues.original_url}
                            placeholder="https://your-very-long-url.com/path/to/page"
                            class={`w-full pl-10 pr-4 py-3 rounded-xl bg-midnight border ${
                                fieldErrors.original_url
                                    ? "border-red-500/50 focus:ring-red-500/20"
                                    : "border-white/10 focus:border-cyan/60 focus:ring-cyan/20"
                            } text-clean placeholder:text-muted/40 text-sm outline-none focus:ring-2 transition-all duration-200`}
                        />
                    </div>
                    {
                        fieldErrors.original_url && (
                            <p class="text-xs text-red-400 mt-1">
                                {fieldErrors.original_url}
                            </p>
                        )
                    }
                </div>

                <!-- Custom alias -->
                <div class="space-y-1.5">
                    <label
                        for="alias"
                        class="block text-sm font-medium text-clean"
                    >
                        Custom Alias
                        <span class="ml-1.5 text-xs text-muted font-normal"
                            >(optional)</span
                        >
                    </label>
                    <div
                        class="flex items-center gap-0 rounded-xl bg-midnight border border-white/10 focus-within:border-cyan/60 focus-within:ring-2 focus-within:ring-cyan/20 transition-all duration-200 overflow-hidden"
                    >
                        <!-- Base URL prefix -->
                        <span
                            class="flex-shrink-0 px-4 py-3 text-sm text-muted border-r border-white/10 bg-white/5 whitespace-nowrap select-none"
                            >{displayHost}/
                        </span>
                        <input
                            id="alias"
                            name="alias"
                            type="text"
                            value={formValues.alias}
                            placeholder={suggestedAlias}
                            maxlength="50"
                            class="flex-1 px-4 py-3 bg-transparent text-clean placeholder:text-muted/40 text-sm outline-none"
                        />
                    </div>
                    {
                        fieldErrors.alias ? (
                            <p class="text-xs text-red-400 mt-1">
                                {fieldErrors.alias}
                            </p>
                        ) : (
                            <p class="text-xs text-muted/60 mt-1">
                                Leave empty to auto-generate. Letters, numbers,
                                hyphens, underscores only.
                            </p>
                        )
                    }
                </div>

                <!-- Live preview -->
                <div
                    class="rounded-xl bg-midnight/60 border border-white/5 px-4 py-3 flex items-center gap-3"
                >
                    <svg
                        class="w-4 h-4 text-cyan flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"
                        ></path>
                    </svg>
                    <div class="min-w-0">
                        <p class="text-xs text-muted mb-0.5">
                            Your short link will look like:
                        </p>
                        <p
                            id="preview-url"
                            class="text-sm font-mono font-semibold text-cyan truncate"
                        >
                         {displayHost}/<span id="preview-alias"
                                >{suggestedAlias}</span
                            >
                        </p>
                    </div>
                </div>

                <!-- ── Smart Features divider ─────────────────────────────── -->
                <div class="border-t border-white/5 pt-4 space-y-3">
                    <p class="text-xs text-muted/70 uppercase tracking-widest font-semibold">Smart Features</p>

                    <!-- Meta-Tag Optimizer -->
                    <div class="rounded-xl border border-white/5 overflow-hidden">
                        <button type="button" id="toggle-meta" class="w-full flex items-center justify-between px-4 py-3 text-sm font-semibold text-clean hover:bg-white/5 transition-colors duration-150 text-left">
                            <span class="flex items-center gap-2">
                                <span>🤖</span> Meta-Tag Optimizer
                                <span class="text-xs text-muted font-normal">(Rich preview for WhatsApp, Twitter)</span>
                            </span>
                            <svg id="meta-chevron" class="w-4 h-4 text-muted transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="meta-panel" class="hidden px-4 pb-4 space-y-3 border-t border-white/5">
                            <p class="text-[11px] text-muted/70 pt-2 pb-1 leading-relaxed">
                                Control how your link appears when shared on social media. <br/>
                                <strong class="text-cyan/80">💡 Need help? Ask Nemo in the bottom right!</strong>
                            </p>
                            <div class="flex gap-2">
                                <button type="button" id="fetch-meta-btn" class="flex-1 py-2 rounded-lg bg-white/5 border border-white/10 text-xs font-semibold text-muted hover:text-clean hover:border-white/20 transition-all duration-150">
                                    ⬇ Fetch from URL
                                </button>
                                <button type="button" id="ai-improve-btn" class="flex-1 py-2 rounded-lg bg-cyan/10 border border-cyan/20 text-xs font-semibold text-cyan hover:bg-cyan/20 transition-all duration-150">
                                    ✨ AI Improve
                                </button>
                            </div>
                            <p class="text-[11px] text-muted/70 leading-tight">
                                ✨ Tip: Fill in the Destination URL, Title, and Description first, then click AI Improve to optimize them for social media.
                            </p>
                            <p id="meta-status" class="text-xs text-muted hidden"></p>
                            <div class="space-y-2">
                                <div>
                                    <label class="text-xs text-muted mb-1 block">Title <span class="text-muted/50">(max 60 chars)</span></label>
                                    <input id="og-title" name="og_title" type="text" maxlength="80" placeholder="Auto-generated from destination URL"
                                        class="w-full px-3 py-2 rounded-lg bg-midnight border border-white/10 text-clean placeholder:text-muted/30 text-sm outline-none focus:border-cyan/50 focus:ring-1 focus:ring-cyan/20 transition-all" />
                                </div>
                                <div>
                                    <label class="text-xs text-muted mb-1 block">Description <span class="text-muted/50">(max 155 chars)</span></label>
                                    <textarea id="og-description" name="og_description" rows="2" maxlength="200" placeholder="Auto-generated from destination URL"
                                        class="w-full px-3 py-2 rounded-lg bg-midnight border border-white/10 text-clean placeholder:text-muted/30 text-sm outline-none focus:border-cyan/50 focus:ring-1 focus:ring-cyan/20 transition-all resize-none"></textarea>
                                </div>
                                <div>
                                    <label class="text-xs text-muted mb-1 block">Thumbnail Image URL</label>
                                    <input id="og-image" name="og_image" type="url" placeholder="https://..."
                                        class="w-full px-3 py-2 rounded-lg bg-midnight border border-white/10 text-clean placeholder:text-muted/30 text-sm outline-none focus:border-cyan/50 focus:ring-1 focus:ring-cyan/20 transition-all" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- A/B Routing -->
                    <div class="rounded-xl border border-white/5 overflow-hidden">
                        <button type="button" id="toggle-ab" class="w-full flex items-center justify-between px-4 py-3 text-sm font-semibold text-clean hover:bg-white/5 transition-colors duration-150 text-left">
                            <span class="flex items-center gap-2">
                                <span>🔀</span> A/B Routing
                                <span class="text-xs text-muted font-normal">(Split traffic between two URLs)</span>
                            </span>
                            <svg id="ab-chevron" class="w-4 h-4 text-muted transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="ab-panel" class="hidden px-4 pb-4 space-y-3 border-t border-white/5 pt-3">
                            <p class="text-[11px] text-muted/70 pb-1 leading-relaxed">
                                Split traffic between your original URL and a second URL to test which performs better. <br/>
                                <strong class="text-cyan/80">💡 What is A/B testing? Ask Nemo!</strong>
                            </p>
                            <div>
                                <label class="text-xs text-muted mb-1 block">URL B (alternate destination)</label>
                                <input id="ab-url-b" name="ab_url_b" type="url" placeholder="https://alternate-destination.com"
                                    class="w-full px-3 py-2 rounded-lg bg-midnight border border-white/10 text-clean placeholder:text-muted/30 text-sm outline-none focus:border-cyan/50 focus:ring-1 focus:ring-cyan/20 transition-all" />
                            </div>
                            <div>
                                <label class="text-xs text-muted mb-1 block">Traffic to URL A: <span id="ab-weight-label" class="text-cyan font-semibold">50%</span></label>
                                <input id="ab-weight" name="ab_weight" type="range" min="10" max="90" value="50"
                                    class="w-full accent-cyan" />
                                <div class="flex justify-between text-xs text-muted/50 mt-0.5">
                                    <span>URL A</span><span>URL B</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Time-Based Redirects -->
                    <div class="rounded-xl border border-white/5 overflow-hidden">
                        <button type="button" id="toggle-time" class="w-full flex items-center justify-between px-4 py-3 text-sm font-semibold text-clean hover:bg-white/5 transition-colors duration-150 text-left">
                            <span class="flex items-center gap-2">
                                <span>⏰</span> Time-Based Redirects
                                <span class="text-xs text-muted font-normal">(Different URL by time of day)</span>
                            </span>
                            <svg id="time-chevron" class="w-4 h-4 text-muted transition-transform duration-200" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/></svg>
                        </button>
                        <div id="time-panel" class="hidden px-4 pb-4 border-t border-white/5 pt-3 space-y-3">
                            <p class="text-[11px] text-muted/70 pb-1 leading-relaxed">
                                Redirect users to different pages depending on what time of day they click the link. <br/>
                                <strong class="text-cyan/80">💡 Ask Nemo how to use Time-Based Redirects!</strong>
                            </p>
                            <div id="time-rules-list" class="space-y-2"></div>
                            <input type="hidden" id="time-rules-json" name="time_rules" value="" />
                            <button type="button" id="add-time-rule" class="w-full py-2 rounded-lg border border-dashed border-white/10 text-xs text-muted hover:border-cyan/30 hover:text-cyan transition-all duration-150">
                                + Add time rule
                            </button>
                        </div>
                    </div>
                </div>

                <!-- Submit -->
                <button
                    id="submit-btn"
                    type="submit"
                    class="w-full py-3.5 bg-cyan hover:bg-cyan/90 text-midnight font-bold rounded-xl text-sm transition-all duration-150 active:scale-[0.98] shadow-[0_0_20px_rgba(6,182,212,0.35)] hover:shadow-[0_0_32px_rgba(6,182,212,0.55)] flex items-center justify-center gap-2"
                >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"></path>
                    </svg>
                    Create Zync Link
                </button>
            </form>
        </div>
    </main>


    <!-- Live alias preview + submit loading state -->
    <script is:inline define:vars={{ suggestedAlias }}>
        const aliasInput = document.getElementById("alias");
        const previewAlias = document.getElementById("preview-alias");
        const form = document.getElementById("new-link-form");
        const submitBtn = document.getElementById("submit-btn");

        aliasInput?.addEventListener("input", () => {
            previewAlias.textContent = aliasInput.value.trim() || suggestedAlias;
        });

        form?.addEventListener("submit", () => {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `<svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path></svg> Creating…`;
        });
    </script>

    <!-- Smart features interactivity -->
    <script is:inline>
        // ── Collapsible panels ─────────────────────────────────────────────────
        function setupToggle(btnId, panelId, chevronId) {
            const btn = document.getElementById(btnId);
            const panel = document.getElementById(panelId);
            const chevron = document.getElementById(chevronId);
            btn?.addEventListener("click", () => {
                const open = !panel.classList.contains("hidden");
                panel.classList.toggle("hidden", open);
                chevron?.classList.toggle("rotate-180", !open);
            });
        }
        setupToggle("toggle-meta", "meta-panel", "meta-chevron");
        setupToggle("toggle-ab", "ab-panel", "ab-chevron");
        setupToggle("toggle-time", "time-panel", "time-chevron");

        // ── A/B weight slider ──────────────────────────────────────────────────
        const weightSlider = document.getElementById("ab-weight");
        const weightLabel = document.getElementById("ab-weight-label");
        weightSlider?.addEventListener("input", () => {
            weightLabel.textContent = weightSlider.value + "%";
        });

        // ── Meta-tag fetch ─────────────────────────────────────────────────────
        const urlInput = document.getElementById("original_url");
        const metaStatus = document.getElementById("meta-status");

        function setMetaStatus(msg, loading = false) {
            metaStatus.textContent = msg;
            metaStatus.classList.remove("hidden");
            metaStatus.className = `text-xs mt-1 ${loading ? "text-muted animate-pulse" : "text-muted"}`;
        }

        document.getElementById("fetch-meta-btn")?.addEventListener("click", async () => {
            const url = urlInput?.value?.trim();
            if (!url) { setMetaStatus("Enter a destination URL first."); return; }
            setMetaStatus("Fetching preview…", true);
            try {
                const res = await fetch("/api/fetch-meta", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ url }),
                });
                const data = await res.json();
                if (data.error) { setMetaStatus("Error: " + data.error); return; }
                document.getElementById("og-title").value = data.title ?? "";
                document.getElementById("og-description").value = data.description ?? "";
                document.getElementById("og-image").value = data.image ?? "";
                setMetaStatus("✓ Preview fetched successfully.");
            } catch {
                setMetaStatus("Failed to fetch. Check the URL and try again.");
            }
        });

        // ── Meta AI improve ────────────────────────────────────────────────────
        document.getElementById("ai-improve-btn")?.addEventListener("click", async () => {
            const url = urlInput?.value?.trim();
            const title = document.getElementById("og-title").value.trim();
            const desc = document.getElementById("og-description").value.trim();

            if (!url && !title && !desc) {
                setMetaStatus("Please fill the Destination URL, Title, or Description first.", true);
                return;
            }

            setMetaStatus("✨ AI is improving your meta tags…", true);
            try {
                const res = await fetch("/api/ai-meta", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                        url,
                        title: document.getElementById("og-title").value,
                        description: document.getElementById("og-description").value,
                    }),
                });
                const data = await res.json();
                if (data.error) { setMetaStatus("AI error: " + data.error); return; }
                if (data.title) document.getElementById("og-title").value = data.title;
                if (data.description) document.getElementById("og-description").value = data.description;
                setMetaStatus("✓ AI improved your meta tags!");
            } catch {
                setMetaStatus("AI request failed. Is Ollama running?");
            }
        });

        // ── Time rules builder ─────────────────────────────────────────────────
        const rulesList = document.getElementById("time-rules-list");
        const rulesJson = document.getElementById("time-rules-json");
        let rules = [];

        function renderRules() {
            rulesList.innerHTML = "";
            rules.forEach((rule, i) => {
                const div = document.createElement("div");
                div.className = "grid grid-cols-[1fr_1fr_1fr_auto] gap-1.5 items-center";
                div.innerHTML = `
                    <input type="time" value="${rule.from}" class="px-2 py-1.5 rounded-lg bg-midnight border border-white/10 text-clean text-xs outline-none focus:border-cyan/50" placeholder="08:00" data-field="from" data-idx="${i}" />
                    <input type="time" value="${rule.to}" class="px-2 py-1.5 rounded-lg bg-midnight border border-white/10 text-clean text-xs outline-none focus:border-cyan/50" placeholder="12:00" data-field="to" data-idx="${i}" />
                    <input type="url" value="${rule.url}" class="px-2 py-1.5 rounded-lg bg-midnight border border-white/10 text-clean text-xs outline-none focus:border-cyan/50" placeholder="https://..." data-field="url" data-idx="${i}" />
                    <button type="button" data-remove="${i}" class="w-6 h-6 flex items-center justify-center text-muted hover:text-red-400 transition-colors text-lg leading-none">×</button>
                `;
                rulesList.appendChild(div);
            });
            // Sync hidden field
            rulesJson.value = rules.length > 0 ? JSON.stringify(rules) : "";
            // Attach listeners
            rulesList.querySelectorAll("input[data-field]").forEach((el) => {
                el.addEventListener("input", () => {
                    const idx = parseInt(el.dataset.idx);
                    rules[idx][el.dataset.field] = el.value;
                    rulesJson.value = rules.length > 0 ? JSON.stringify(rules) : "";
                });
            });
            rulesList.querySelectorAll("button[data-remove]").forEach((btn) => {
                btn.addEventListener("click", () => {
                    rules.splice(parseInt(btn.dataset.remove), 1);
                    renderRules();
                });
            });
        }

        document.getElementById("add-time-rule")?.addEventListener("click", () => {
            rules.push({ from: "08:00", to: "12:00", tz: "Asia/Jakarta", url: "" });
            renderRules();
        });
    </script>
</Layout>
