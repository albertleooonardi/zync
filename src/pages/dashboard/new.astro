---
import Layout from "../../layouts/Layout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";

// ── Auth guard ────────────────────────────────────────────────────────────────
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const {
    data: { session },
} = await supabase.auth.getSession();

if (!session) {
    return Astro.redirect("/login");
}

const user = session.user;

// ── Helpers ───────────────────────────────────────────────────────────────────
function randomAlias(len = 6): string {
    const chars = "abcdefghijkmnopqrstuvwxyz23456789";
    return Array.from(
        { length: len },
        () => chars[Math.floor(Math.random() * chars.length)]
    ).join("");
}

function isValidUrl(str: string): boolean {
    try {
        const url = new URL(str);
        return url.protocol === "http:" || url.protocol === "https:";
    } catch {
        return false;
    }
}

// ── Form state ────────────────────────────────────────────────────────────────
let errorMessage = "";
let fieldErrors: Record<string, string> = {};
let formValues = { original_url: "", alias: "" };
const suggestedAlias = randomAlias();

// ── POST handler ──────────────────────────────────────────────────────────────
if (Astro.request.method === "POST") {
    const formData = await Astro.request.formData();
    const originalUrl = formData.get("original_url")?.toString().trim() ?? "";
    const rawAlias = formData.get("alias")?.toString().trim() ?? "";
    const alias = rawAlias || randomAlias();

    formValues = { original_url: originalUrl, alias: rawAlias };

    // Validate
    if (!originalUrl) {
        fieldErrors.original_url = "Please enter a destination URL.";
    } else if (!isValidUrl(originalUrl)) {
        fieldErrors.original_url =
            "Must be a valid URL starting with http:// or https://";
    }

    if (rawAlias && !/^[a-zA-Z0-9_-]{2,50}$/.test(rawAlias)) {
        fieldErrors.alias =
            "Only letters, numbers, hyphens and underscores (2–50 chars).";
    }

    if (Object.keys(fieldErrors).length === 0) {
        // Check alias uniqueness
        const { data: existing } = await supabase
            .from("links")
            .select("id")
            .eq("alias", alias)
            .maybeSingle();

        if (existing) {
            fieldErrors.alias = `"${alias}" is already taken. Try a different alias.`;
        } else {
            const { error: insertError } = await supabase
                .from("links")
                .insert({ user_id: user.id, alias, original_url: originalUrl });

            if (insertError) {
                errorMessage = "Something went wrong. Please try again.";
            } else {
                return Astro.redirect(
                    "/dashboard?created=" + encodeURIComponent(alias)
                );
            }
        }
    }
}
---

<Layout title="Create New Link — Zync" description="Shorten a URL with Zync.">
    <DashboardNav userEmail={user.email} />

    <main class="mx-auto max-w-2xl px-4 sm:px-6 lg:px-8 py-12 space-y-8">
        <!-- Header -->
        <div class="space-y-1">
            <a
                href="/dashboard"
                class="inline-flex items-center gap-1.5 text-sm text-muted hover:text-clean transition-colors mb-3"
            >
                <svg
                    class="w-4 h-4"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                >
                    <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        d="M15 19l-7-7 7-7"></path>
                </svg>
                Back to Dashboard
            </a>
            <h1 class="text-3xl font-black text-clean">✨ Create New Zync</h1>
            <p class="text-sm text-muted">
                Shorten a URL and start tracking clicks instantly.
            </p>
        </div>

        <!-- Global error -->
        {
            errorMessage && (
                <div class="flex items-center gap-3 rounded-xl border border-red-500/30 bg-red-500/10 px-4 py-3 text-sm text-red-400">
                    <svg
                        class="w-4 h-4 flex-shrink-0"
                        fill="currentColor"
                        viewBox="0 0 20 20"
                    >
                        <path
                            fill-rule="evenodd"
                            d="M18 10a8 8 0 11-16 0 8 8 0 0116 0zm-7 4a1 1 0 11-2 0 1 1 0 012 0zm-1-9a1 1 0 00-1 1v4a1 1 0 102 0V6a1 1 0 00-1-1z"
                            clip-rule="evenodd"
                        />
                    </svg>
                    {errorMessage}
                </div>
            )
        }

        <!-- Form card -->
        <div class="rounded-2xl bg-river border border-white/5 p-7 space-y-6">
            <form method="POST" class="space-y-6" novalidate id="new-link-form">
                <!-- Destination URL -->
                <div class="space-y-1.5">
                    <label
                        for="original_url"
                        class="block text-sm font-medium text-clean"
                    >
                        Destination URL <span class="text-red-400">*</span>
                    </label>
                    <div class="relative">
                        <div
                            class="pointer-events-none absolute inset-y-0 left-0 flex items-center pl-4"
                        >
                            <svg
                                class="w-4 h-4 text-muted"
                                fill="none"
                                stroke="currentColor"
                                stroke-width="2"
                                viewBox="0 0 24 24"
                            >
                                <path
                                    stroke-linecap="round"
                                    stroke-linejoin="round"
                                    d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1"
                                ></path>
                            </svg>
                        </div>
                        <input
                            id="original_url"
                            name="original_url"
                            type="url"
                            required
                            value={formValues.original_url}
                            placeholder="https://your-very-long-url.com/path/to/page"
                            class={`w-full pl-10 pr-4 py-3 rounded-xl bg-midnight border ${
                                fieldErrors.original_url
                                    ? "border-red-500/50 focus:ring-red-500/20"
                                    : "border-white/10 focus:border-cyan/60 focus:ring-cyan/20"
                            } text-clean placeholder:text-muted/40 text-sm outline-none focus:ring-2 transition-all duration-200`}
                        />
                    </div>
                    {
                        fieldErrors.original_url && (
                            <p class="text-xs text-red-400 mt-1">
                                {fieldErrors.original_url}
                            </p>
                        )
                    }
                </div>

                <!-- Custom alias -->
                <div class="space-y-1.5">
                    <label
                        for="alias"
                        class="block text-sm font-medium text-clean"
                    >
                        Custom Alias
                        <span class="ml-1.5 text-xs text-muted font-normal"
                            >(optional)</span
                        >
                    </label>
                    <div
                        class="flex items-center gap-0 rounded-xl bg-midnight border border-white/10 focus-within:border-cyan/60 focus-within:ring-2 focus-within:ring-cyan/20 transition-all duration-200 overflow-hidden"
                    >
                        <!-- Base URL prefix -->
                        <span
                            class="flex-shrink-0 px-4 py-3 text-sm text-muted border-r border-white/10 bg-white/5 whitespace-nowrap select-none"
                        >
                            {Astro.url.host}/
                        </span>
                        <input
                            id="alias"
                            name="alias"
                            type="text"
                            value={formValues.alias}
                            placeholder={suggestedAlias}
                            maxlength="50"
                            class="flex-1 px-4 py-3 bg-transparent text-clean placeholder:text-muted/40 text-sm outline-none"
                        />
                    </div>
                    {
                        fieldErrors.alias ? (
                            <p class="text-xs text-red-400 mt-1">
                                {fieldErrors.alias}
                            </p>
                        ) : (
                            <p class="text-xs text-muted/60 mt-1">
                                Leave empty to auto-generate. Letters, numbers,
                                hyphens, underscores only.
                            </p>
                        )
                    }
                </div>

                <!-- Live preview -->
                <div
                    class="rounded-xl bg-midnight/60 border border-white/5 px-4 py-3 flex items-center gap-3"
                >
                    <svg
                        class="w-4 h-4 text-cyan flex-shrink-0"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"
                        ></path>
                    </svg>
                    <div class="min-w-0">
                        <p class="text-xs text-muted mb-0.5">
                            Your short link will look like:
                        </p>
                        <p
                            id="preview-url"
                            class="text-sm font-mono font-semibold text-cyan truncate"
                        >
                            {Astro.url.host}/<span id="preview-alias"
                                >{suggestedAlias}</span
                            >
                        </p>
                    </div>
                </div>

                <!-- Submit -->
                <button
                    id="submit-btn"
                    type="submit"
                    class="w-full py-3.5 bg-cyan hover:bg-cyan/90 text-midnight font-bold rounded-xl text-sm transition-all duration-150 active:scale-[0.98] shadow-[0_0_20px_rgba(6,182,212,0.35)] hover:shadow-[0_0_32px_rgba(6,182,212,0.55)] flex items-center justify-center gap-2"
                >
                    <svg
                        class="w-4 h-4"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2.5"
                        viewBox="0 0 24 24"
                    >
                        <path
                            stroke-linecap="round"
                            stroke-linejoin="round"
                            d="M13.19 8.688a4.5 4.5 0 011.242 7.244l-4.5 4.5a4.5 4.5 0 01-6.364-6.364l1.757-1.757m13.35-.622l1.757-1.757a4.5 4.5 0 00-6.364-6.364l-4.5 4.5a4.5 4.5 0 001.242 7.244"
                        ></path>
                    </svg>
                    Create Zync Link
                </button>
            </form>
        </div>
    </main>

    <!-- Live alias preview + submit loading state -->
    <script define:vars={{ suggestedAlias }}>
        const aliasInput = document.getElementById("alias");
        const previewAlias = document.getElementById("preview-alias");
        const form = document.getElementById("new-link-form");
        const submitBtn = document.getElementById("submit-btn");

        // Update preview as user types alias
        aliasInput?.addEventListener("input", () => {
            previewAlias.textContent =
                aliasInput.value.trim() || suggestedAlias;
        });

        // Show loading state on submit
        form?.addEventListener("submit", () => {
            submitBtn.disabled = true;
            submitBtn.innerHTML = `
                <svg class="w-4 h-4 animate-spin" fill="none" viewBox="0 0 24 24">
                    <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                    <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4z"></path>
                </svg>
                Creating…
            `;
        });
    </script>
</Layout>
