---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";
---

<Layout title="Features — Zync" description="Supercharge your links with real-time analytics, AI tags, and smart routing.">
    <Navbar />

    <main class="min-h-screen pt-24 pb-20 overflow-hidden">
        
        <!-- Hero Section -->
        <section class="max-w-6xl mx-auto px-4 sm:px-6 pt-16 pb-12 text-center">
            <h1 class="text-4xl md:text-6xl font-black text-[#F8FAFC] tracking-tight mb-6 mt-8">
                Supercharge Your <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#06B6D4] to-[#EC4899]">Links.</span>
            </h1>
            <p class="text-lg md:text-xl text-[#94A3B8] max-w-2xl mx-auto leading-relaxed">
                Zync goes beyond simple redirection. We equip creators and builders with the smart tools needed to grow their audience, secure traffic, and analyze engagement in real-time.
            </p>
        </section>

        <!-- Bento Grid -->
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-12">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-6 auto-rows-fr">
                
                <!-- Card 1: Realtime Analytics (Large) -->
                <div class="md:col-span-3 bg-[#1E293B] rounded-3xl border border-white/5 p-8 flex flex-col justify-between hover:scale-[1.02] transition-transform duration-300 shadow-xl overflow-hidden relative group">
                    <div class="relative z-10">
                        <h2 class="text-2xl font-bold text-[#F8FAFC] mb-2 flex items-center gap-3">
                            <span class="relative flex h-3 w-3">
                              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#06B6D4] opacity-75"></span>
                              <span class="relative inline-flex rounded-full h-3 w-3 bg-[#06B6D4]"></span>
                            </span>
                            Realtime Analytics
                        </h2>
                        <p class="text-[#94A3B8] max-w-md">Watch your audience engage live. No refreshing, no waiting. Instant data synchronization powered by WebSockets.</p>
                    </div>
                    
                    <!-- Mock Chart UI -->
                    <div class="mt-8 pt-8 border-t border-white/10 relative z-10 flex items-end gap-3 h-40 opacity-80 group-hover:opacity-100 transition-opacity">
                        <!-- Chart Bars -->
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[40%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-[#06B6D4]/40 h-full"></div></div>
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[60%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-[#06B6D4]/50 h-full"></div></div>
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[30%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-[#06B6D4]/40 h-full"></div></div>
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[80%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-[#06B6D4]/70 h-full"></div></div>
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[50%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-[#06B6D4]/50 h-full"></div></div>
                        <div class="w-full bg-[#0B0F19]/50 rounded-t-sm h-[90%] relative overflow-hidden"><div class="absolute bottom-0 w-full bg-gradient-to-t from-[#06B6D4] to-[#EC4899] h-full shadow-[0_0_15px_rgba(6,182,212,0.8)]"></div></div>
                    </div>
                    
                    <!-- Ambient Background Glow -->
                    <div class="absolute -right-20 -bottom-20 w-64 h-64 bg-[#06B6D4]/20 blur-[100px] rounded-full pointer-events-none"></div>
                </div>

                <!-- Card 2: Deep Linking (Medium) -->
                <div class="md:col-span-1 bg-[#1E293B] rounded-3xl border border-white/5 p-8 flex flex-col justify-between hover:scale-[1.02] transition-transform duration-300 shadow-xl overflow-hidden relative group">
                    <div class="relative z-10 space-y-2">
                        <div class="w-12 h-12 rounded-xl bg-[#0B0F19] flex items-center justify-center border border-white/10 mb-6 drop-shadow-[0_0_15px_rgba(236,72,153,0.5)]">
                            <svg class="w-6 h-6 text-[#EC4899]" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path></svg>
                        </div>
                        <h2 class="text-xl font-bold text-[#F8FAFC]">Deep Linking</h2>
                        <p class="text-[#94A3B8] text-sm">Force open native apps like Instagram, TikTok, or YouTube instantly instead of getting trapped in a mobile browser.</p>
                    </div>
                    <div class="absolute -right-10 -top-10 w-40 h-40 bg-[#EC4899]/20 blur-[60px] rounded-full pointer-events-none"></div>
                </div>

                <!-- Card 3: AI Meta-Tags (Medium) -->
                <div class="md:col-span-2 bg-[#1E293B] rounded-3xl border border-white/5 p-8 flex flex-col md:flex-row gap-8 items-center justify-between hover:scale-[1.02] transition-transform duration-300 shadow-xl overflow-hidden relative group">
                    <div class="relative z-10 flex-1 space-y-4">
                        <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-gradient-to-r from-[#06B6D4]/10 to-[#EC4899]/10 border border-[#06B6D4]/20 text-xs font-semibold text-[#06B6D4]">
                            <span>✨</span> AI-Powered
                        </div>
                        <h2 class="text-2xl font-bold text-[#F8FAFC]">Meta-Tag Optimizer</h2>
                        <p class="text-[#94A3B8]">Auto-generate stunning social previews for WhatsApp, Twitter, and iMessage using our Gemini-integrated AI engine.</p>
                    </div>
                    
                    <!-- Mock Social Card -->
                    <div class="w-full md:w-64 bg-[#0B0F19] rounded-xl border border-white/10 overflow-hidden shadow-lg transform group-hover:-rotate-2 transition-transform">
                        <div class="h-24 bg-gradient-to-br from-[#1E293B] to-[#0B0F19] relative">
                            <div class="absolute inset-0 flex flex-wrap items-center justify-center opacity-30">
                                <span class="text-4xl">🚀</span>
                            </div>
                        </div>
                        <div class="p-4 space-y-2">
                            <div class="h-3 bg-white/10 rounded-full w-3/4"></div>
                            <div class="h-2 bg-white/5 rounded-full w-full"></div>
                            <div class="h-2 bg-white/5 rounded-full w-5/6"></div>
                        </div>
                    </div>
                </div>

                <!-- Card 4: Phishing Shield (Small) -->
                <div class="md:col-span-1 bg-[#1E293B] rounded-3xl border border-white/5 p-8 flex flex-col justify-between hover:scale-[1.02] transition-transform duration-300 shadow-xl overflow-hidden relative group">
                    <div class="relative z-10 space-y-2">
                        <div class="w-12 h-12 rounded-xl bg-green-500/10 flex items-center justify-center border border-green-500/20 mb-6 drop-shadow-[0_0_15px_rgba(34,197,94,0.3)]">
                            <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>
                        </div>
                        <h2 class="text-xl font-bold text-[#F8FAFC]">Phishing Shield</h2>
                        <p class="text-[#94A3B8] text-sm">Every created link is automatically scanned and protected against spam and malicious bots.</p>
                    </div>
                </div>

                <!-- Card 5: Custom Domains (Small) -->
                <div class="md:col-span-1 bg-[#1E293B] rounded-3xl border border-white/5 p-8 flex flex-col justify-between hover:scale-[1.02] transition-transform duration-300 shadow-xl overflow-hidden relative group">
                    <div class="relative z-10 space-y-2">
                        <div class="w-12 h-12 rounded-xl bg-purple-500/10 flex items-center justify-center border border-purple-500/20 mb-6 drop-shadow-[0_0_15px_rgba(168,85,247,0.3)]">
                            <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"></path></svg>
                        </div>
                        <h2 class="text-xl font-bold text-[#F8FAFC]">Custom Domains</h2>
                        <p class="text-[#94A3B8] text-sm">Attach your own domain name to brand your links.</p>
                        
                        <div class="mt-4 inline-block px-3 py-1.5 rounded-lg bg-[#0B0F19] border border-white/10 text-xs font-mono text-[#F8FAFC]">
                            link.<span class="text-[#06B6D4]">yourname</span>.com
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <!-- CTA Section -->
        <section class="max-w-4xl mx-auto px-4 sm:px-6 py-24 text-center">
            <div class="bg-gradient-to-b from-[#1E293B] to-[#0B0F19] rounded-[2.5rem] p-12 md:p-16 border border-white/5 shadow-2xl relative overflow-hidden">
                <div class="absolute inset-0 bg-[linear-gradient(to_right,#06B6D4_0%,#EC4899_100%)] opacity-[0.03]"></div>
                
                <h2 class="text-3xl md:text-5xl font-black text-[#F8FAFC] mb-6 relative z-10">
                    Ready to sync your growth?
                </h2>
                <p class="text-[#94A3B8] mb-10 text-lg relative z-10 max-w-xl mx-auto">
                    Join thousands of creators using Zync to measure what matters and direct audiences smarter.
                </p>
                <a 
                    href="/signup" 
                    class="relative z-10 inline-flex items-center justify-center px-8 py-4 text-base font-bold text-[#0B0F19] transition-all bg-[#06B6D4] rounded-xl hover:bg-[#06B6D4]/90 hover:scale-105 shadow-[0_0_30px_rgba(6,182,212,0.4)]"
                >
                    Start for Free
                </a>
            </div>
        </section>

    </main>
    <Footer />
</Layout>
