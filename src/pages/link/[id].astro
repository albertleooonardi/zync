---
import Layout from "../../layouts/Layout.astro";
import { createSupabaseServerClient } from "../../lib/supabase";
import DashboardNav from "../../components/dashboard/DashboardNav.astro";
import AnalyticsHeader from "../../components/analytics/AnalyticsHeader.astro";
import ClicksChart from "../../components/analytics/ClicksChart.astro";
import ReferrerBreakdown from "../../components/analytics/ReferrerBreakdown.astro";
import DeviceBreakdown from "../../components/analytics/DeviceBreakdown.astro";
import GeoBreakdown from "../../components/analytics/GeoBreakdown.astro";


// ── Auth ──────────────────────────────────────────────────────────────────────
const supabase = createSupabaseServerClient(Astro.request, Astro.cookies);
const { data: { user }, error: authError } = await supabase.auth.getUser();
if (authError || !user) return Astro.redirect("/login");

// ── Fetch link ────────────────────────────────────────────────────────────────
const { id } = Astro.params;
const { data: link, error: linkError } = await supabase
    .from("links")
    .select("id, alias, original_url, created_at, user_id")
    .eq("id", id!)
    .eq("user_id", user.id)
    .single();

if (linkError || !link) return Astro.redirect("/dashboard");

// ── Fetch clicks ──────────────────────────────────────────────────────────────
const { data: clickRows } = await supabase
    .from("clicks")
    .select("clicked_at, referrer, country, user_agent, device")
    .eq("link_id", link.id)
    .order("clicked_at", { ascending: true });

const safeClicks = (clickRows ?? []) as Array<{
    clicked_at: string;
    referrer: string | null;
    country: string | null;
    user_agent: string | null;
    device: string | null;
}>;


// ── Helper: detect device from user_agent ─────────────────────────────────────
function detectDevice(ua: string | null): string {
    if (!ua) return "unknown";
    const u = ua.toLowerCase();
    if (/ipad|tablet|(android(?!.*mobile))/.test(u)) return "tablet";
    if (/mobile|android|iphone|ipod|blackberry|opera mini|iemobile/.test(u))
        return "mobile";
    return "desktop";
}


// ── Aggregate: referrers ──────────────────────────────────────────────────────
function buildReferrers() {
    const counts: Record<string, number> = {};
    for (const c of safeClicks) {
        let name = "Direct";
        if (c.referrer) {
            try {
                const u = new URL(c.referrer);
                name = u.hostname.replace(/^www\./, "");
            } catch {
                name = c.referrer.slice(0, 30);
            }
        }
        counts[name] = (counts[name] ?? 0) + 1;
    }
    const total = safeClicks.length || 1;
    return Object.entries(counts)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 6)
        .map(([name, count]) => ({
            name,
            count,
            percent: Math.round((count / total) * 100),
        }));
}

// ── Aggregate: devices ────────────────────────────────────────────────────────
function buildDevices() {
    const counts: Record<string, number> = {};
    for (const c of safeClicks) {
        const dev =
            c.device && c.device !== "unknown"
                ? c.device
                : detectDevice(c.user_agent);
        counts[dev] = (counts[dev] ?? 0) + 1;
    }
    const total = safeClicks.length || 1;
    return Object.entries(counts)
        .sort((a, b) => b[1] - a[1])
        .map(([name, count]) => ({
            name,
            count,
            percent: Math.round((count / total) * 100),
        }));
}

// ── Aggregate: geography ──────────────────────────────────────────────────────
function buildGeo() {
    const counts: Record<string, number> = {};
    for (const c of safeClicks) {
        const country = c.country || "Unknown";
        counts[country] = (counts[country] ?? 0) + 1;
    }
    const total = safeClicks.length || 1;
    return Object.entries(counts)
        .sort((a, b) => b[1] - a[1])
        .slice(0, 5)
        .map(([country, count]) => ({
            country,
            count,
            percent: Math.round((count / total) * 100),
        }));
}

const referrers = buildReferrers();
const devices = buildDevices();
const geoData = buildGeo();
const totalClicks = safeClicks.length;
const shortUrl = `${Astro.url.host}/${link.alias}`;
---

<Layout
    title={`Analytics — ${link.alias} — Zync`}
    description={`Click analytics for ${link.alias}`}
>
    <DashboardNav userEmail={user.email} />

    <main class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8 py-10 space-y-8">

        <!-- Header -->
        <AnalyticsHeader
            alias={link.alias}
            originalUrl={link.original_url}
            shortUrl={shortUrl}
            linkId={link.id}
        />

        <!-- Quick stat pills -->
        <div class="flex flex-wrap gap-3">
            <!-- Total Clicks — has id for Realtime live update -->
            <div class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-river border border-white/5">
                <span class="text-xs text-muted">Total Clicks</span>
                <span
                    id="analytics-total-clicks"
                    class="text-sm font-bold text-cyan transition-colors duration-300"
                >
                    {totalClicks.toLocaleString()}
                </span>
            </div>
            <!-- Other pills -->
            {
                [
                    {
                        label: "Created",
                        value: new Date(link.created_at).toLocaleDateString(
                            "en-US",
                            { month: "short", day: "numeric", year: "numeric" }
                        ),
                        color: "text-clean",
                    },
                    {
                        label: "Top Referrer",
                        value: referrers[0]?.name ?? "—",
                        color: "text-pink",
                    },
                    {
                        label: "Top Country",
                        value: geoData[0]?.country ?? "—",
                        color: "text-clean",
                    },
                ].map(({ label, value, color }) => (
                    <div class="flex items-center gap-2.5 px-4 py-2 rounded-xl bg-river border border-white/5">
                        <span class="text-xs text-muted">{label}</span>
                        <span class={`text-sm font-bold ${color}`}>
                            {value}
                        </span>
                    </div>
                ))
            }
        </div>

        <!-- Clicks chart (with range filter) -->
        <ClicksChart
            clicks={safeClicks}
            linkCreatedAt={link.created_at}
            totalClicks={totalClicks}
        />

        <!-- Breakdown grid -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            <ReferrerBreakdown referrers={referrers} />
            <DeviceBreakdown devices={devices} />
            <GeoBreakdown geoData={geoData} />
        </div>
    </main>
</Layout>

<!-- Hidden element to pass SSR values to the client-side Realtime script -->
<div
    id="rt-config"
    data-url={import.meta.env.PUBLIC_SUPABASE_URL}
    data-key={import.meta.env.PUBLIC_SUPABASE_ANON_KEY}
    data-token={Astro.cookies.get("sb-access-token")?.value}
    data-link-id={link.id}
    data-total={totalClicks}
    hidden
></div>

<script>
    import { createClient } from "@supabase/supabase-js";

    const cfg = document.getElementById("rt-config")!;
    const token = cfg.dataset.token;
    
    // We MUST pass the Auth token here, otherwise Realtime connects anonymously 
    // and Postgres Row Level Security (RLS) silently blocks all INSERT events.
    const sb = createClient(cfg.dataset.url!, cfg.dataset.key!, {
        global: {
            headers: token ? { Authorization: `Bearer ${token}` } : {}
        }
    });
    const linkId = cfg.dataset.linkId!;
    let liveTotal = parseInt(cfg.dataset.total ?? "0", 10);

    const totalEl = document.getElementById("analytics-total-clicks");

    // Small "live" pulse dot appended next to the counter
    if (totalEl) {
        const pulse = document.createElement("span");
        pulse.className =
            "inline-block w-2 h-2 rounded-full bg-cyan animate-pulse ml-1.5 align-middle opacity-70";
        pulse.title = "Live";
        totalEl.parentElement?.appendChild(pulse);
    }

    sb.channel(`analytics-${linkId}`)
        .on(
            "postgres_changes",
            {
                event: "INSERT",
                schema: "public",
                table: "clicks",
                filter: `link_id=eq.${linkId}`,
            },
            (payload) => {
                liveTotal++;
                if (totalEl) {
                    totalEl.textContent = liveTotal.toLocaleString();
                    totalEl.style.color = "#22d3ee";
                    setTimeout(() => (totalEl.style.color = ""), 800);
                }
                
                // Dispatch a custom event with the new click data
                // Child components (like ClicksChart) listen to this to update their UI
                window.dispatchEvent(
                    new CustomEvent("new-click", { detail: payload.new })
                );
            }
        )
        .subscribe();
</script>
