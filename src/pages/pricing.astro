---
import Layout from "../layouts/Layout.astro";
import Navbar from "../components/Navbar.astro";
import Footer from "../components/Footer.astro";

// SVG Icons
const CheckIcon = `
<svg class="w-5 h-5 text-green-400 mx-auto" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
</svg>
`;

const DashIcon = `
<svg class="w-5 h-5 text-[#94A3B8] mx-auto opacity-50" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
    <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4"></path>
</svg>
`;
---

<Layout title="Pricing — Zync" description="Choose the perfect plan for your personal brand or business.">
    <!-- Removed Midtrans Script -->
    
    <Navbar />

    <main class="min-h-screen pt-24 pb-20 bg-[#0B0F19]">
        <!-- Header -->
        <section class="max-w-4xl mx-auto px-4 sm:px-6 pt-16 pb-12 text-center text-[#F8FAFC]">
            <h1 class="text-4xl md:text-5xl font-black tracking-tight mb-4">
                Simple, Transparent <span class="text-transparent bg-clip-text bg-gradient-to-r from-[#06B6D4] to-[#EC4899]">Pricing.</span>
            </h1>
            <p class="text-lg text-[#94A3B8] max-w-2xl mx-auto">
                Choose the perfect plan for your personal brand or business.
            </p>

            <!-- Billing Toggle -->
            <div class="mt-8 flex items-center justify-center gap-4">
                <span class="text-sm font-semibold text-[#F8FAFC]">Monthly</span>
                <button
                    type="button"
                    class="relative inline-flex h-7 w-14 items-center rounded-full bg-[#06B6D4]/20 p-1 border border-[#06B6D4]/50 cursor-pointer"
                    aria-label="Toggle annual billing"
                >
                    <span class="inline-block h-5 w-5 translate-x-7 transform rounded-full bg-[#06B6D4] transition" />
                </button>
                <div class="flex items-center gap-2">
                    <span class="text-sm font-semibold text-[#94A3B8]">Annually</span>
                    <span class="inline-flex items-center rounded-full bg-green-500/10 px-2.5 py-0.5 text-xs font-semibold text-green-400 border border-green-500/20">
                        Save 20%
                    </span>
                </div>
            </div>
        </section>

        <!-- Pricing Cards -->
        <section class="max-w-6xl mx-auto px-4 sm:px-6 py-8">
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 items-center">
                
                <!-- Card 1: Hobby / Free -->
                <div class="bg-[#1E293B] rounded-3xl p-8 border border-white/5 flex flex-col items-center text-center shadow-xl">
                    <h3 class="text-xl font-bold text-[#F8FAFC] mb-2">Hobby</h3>
                    <div class="flex items-baseline gap-1 my-4">
                        <span class="text-2xl font-bold text-[#94A3B8]">$</span>
                        <span class="text-4xl font-black text-[#F8FAFC]">0</span>
                        <span class="text-[#94A3B8] text-sm">/mo</span>
                    </div>
                    <p class="text-sm text-[#94A3B8] mb-8">Perfect for getting started.</p>
                    
                    <ul class="space-y-4 text-sm text-[#F8FAFC] mb-8 w-full text-left">
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">50 links/mo</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Basic analytics</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Standard redirect</span></li>
                    </ul>

                    <a href="/signup" class="w-full py-3 rounded-xl border border-white/10 text-sm font-semibold text-[#F8FAFC] hover:bg-white/5 transition-colors mt-auto">
                        Get Started
                    </a>
                </div>

                <!-- Card 2: Creator / Pro (Highlighted) -->
                <div class="bg-[#1E293B] rounded-3xl p-8 border-2 border-[#06B6D4] flex flex-col items-center text-center shadow-[0_0_15px_rgba(6,182,212,0.3)] relative transform scale-105 z-10">
                    <div class="absolute -top-4 bg-gradient-to-r from-[#06B6D4] to-[#EC4899] text-[#0B0F19] text-xs font-bold uppercase tracking-wider px-4 py-1.5 rounded-full shadow-md">
                        Most Popular
                    </div>
                    
                    <h3 class="text-xl font-bold text-[#06B6D4] mb-2 pt-2">Creator</h3>
                    <div class="flex items-baseline gap-1 my-4">
                        <span class="text-2xl font-bold text-[#94A3B8]">$</span>
                        <span class="text-5xl font-black text-[#F8FAFC]">9</span>
                        <span class="text-[#94A3B8] text-sm">/mo</span>
                    </div>
                    <p class="text-sm text-[#94A3B8] mb-8">For growing creators and brands.</p>
                    
                    <ul class="space-y-4 text-sm text-[#F8FAFC] mb-8 w-full text-left">
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Unlimited links</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Deep Linking</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">AI Meta-Tags</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1 opacity-100">Real-time analytics</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">1 Custom Domain</span></li>
                    </ul>

                    <button data-plan="creator" class="checkout-btn w-full py-3 rounded-xl bg-[#06B6D4] text-[#0B0F19] text-sm font-bold hover:bg-[#06B6D4]/90 transition-colors mt-auto shadow-md">
                        Start Creator Plan
                    </button>
                </div>

                <!-- Card 3: Business -->
                <div class="bg-[#1E293B] rounded-3xl p-8 border border-white/5 flex flex-col items-center text-center shadow-xl">
                    <h3 class="text-xl font-bold text-[#F8FAFC] mb-2">Business</h3>
                    <div class="flex items-baseline gap-1 my-4">
                        <span class="text-2xl font-bold text-[#94A3B8]">$</span>
                        <span class="text-4xl font-black text-[#F8FAFC]">29</span>
                        <span class="text-[#94A3B8] text-sm">/mo</span>
                    </div>
                    <p class="text-sm text-[#94A3B8] mb-8">For advanced teams and businesses.</p>
                    
                    <ul class="space-y-4 text-sm text-[#F8FAFC] mb-8 w-full text-left">
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Everything in Creator</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">API Access</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Team collaboration</span></li>
                        <li class="flex items-center gap-3"><Fragment set:html={CheckIcon} /> <span class="flex-1">Multiple custom domains</span></li>
                    </ul>

                    <button data-plan="business" class="checkout-btn w-full py-3 rounded-xl border border-white/10 text-sm font-semibold text-[#F8FAFC] hover:bg-white/5 transition-colors mt-auto">
                        Start Business Plan
                    </button>
                </div>

            </div>
        </section>

        <!-- Feature Comparison Table -->
        <section class="max-w-4xl mx-auto px-4 sm:px-6 py-16 hidden md:block">
            <h2 class="text-2xl font-bold text-[#F8FAFC] text-center mb-8">Compare Plans</h2>
            <div class="bg-[#1E293B] rounded-2xl border border-white/5 overflow-hidden shadow-xl">
                <table class="w-full text-left border-collapse">
                    <thead>
                        <tr class="border-b border-white/10">
                            <th class="p-4 text-sm font-medium text-[#94A3B8] w-2/5">Features</th>
                            <th class="p-4 text-sm font-bold text-[#F8FAFC] text-center w-1/5">Hobby</th>
                            <th class="p-4 text-sm font-bold text-[#06B6D4] text-center w-1/5">Creator</th>
                            <th class="p-4 text-sm font-bold text-[#F8FAFC] text-center w-1/5">Business</th>
                        </tr>
                    </thead>
                    <tbody class="text-sm text-[#F8FAFC]">
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Monthly Links</td>
                            <td class="p-4 text-center">50</td>
                            <td class="p-4 text-center">Unlimited</td>
                            <td class="p-4 text-center">Unlimited</td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Analytics</td>
                            <td class="p-4 text-center">Basic</td>
                            <td class="p-4 text-center">Real-time</td>
                            <td class="p-4 text-center">Advanced + Export</td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Custom Domains</td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center">1</td>
                            <td class="p-4 text-center">5</td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Deep Linking</td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">AI Meta-Tags</td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Phishing Shield</td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                        </tr>
                        <tr class="border-b border-white/5 hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">API Access</td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={CheckIcon} /></td>
                        </tr>
                        <tr class="hover:bg-white/[0.02] transition-colors">
                            <td class="p-4">Team Members</td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center"><Fragment set:html={DashIcon} /></td>
                            <td class="p-4 text-center">Up to 5</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </section>

        <!-- FAQ Section -->
        <section class="max-w-3xl mx-auto px-4 sm:px-6 py-16">
            <h2 class="text-2xl font-bold text-[#F8FAFC] text-center mb-10">Frequently Asked Questions</h2>
            <div class="space-y-4">
                
                <details class="group bg-[#1E293B] rounded-2xl border border-white/5 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 font-semibold text-[#F8FAFC] focus:outline-none focus:bg-white/5 hover:bg-white/[0.02] transition-colors">
                        <span class="text-base">Can I cancel my subscription anytime?</span>
                        <span class="relative h-5 w-5 shrink-0">
                            <svg class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <svg class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                            </svg>
                        </span>
                    </summary>
                    <div class="px-5 pb-5 pt-0 text-sm text-[#94A3B8] leading-relaxed border-t border-white/5 mt-2 pt-4">
                        Yes, absolutely. You can upgrade, downgrade, or cancel your subscription at any time directly from your dashboard settings. If you cancel, you'll retain access to your paid features until the end of your current billing cycle.
                    </div>
                </details>

                <details class="group bg-[#1E293B] rounded-2xl border border-white/5 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 font-semibold text-[#F8FAFC] focus:outline-none focus:bg-white/5 hover:bg-white/[0.02] transition-colors">
                        <span class="text-base">How does Deep Linking work?</span>
                        <span class="relative h-5 w-5 shrink-0">
                            <svg class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <svg class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                            </svg>
                        </span>
                    </summary>
                    <div class="px-5 pb-5 pt-0 text-sm text-[#94A3B8] leading-relaxed border-t border-white/5 mt-2 pt-4">
                        Deep Linking ensures your audience is directed to the native app (like Instagram, TikTok, or YouTube) instead of the in-app browser when they click your link. This dramatically increases conversion rates, as users are already logged into their native apps.
                    </div>
                </details>

                <details class="group bg-[#1E293B] rounded-2xl border border-white/5 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 font-semibold text-[#F8FAFC] focus:outline-none focus:bg-white/5 hover:bg-white/[0.02] transition-colors">
                        <span class="text-base">What happens if I exceed my link limit on the Hobby plan?</span>
                        <span class="relative h-5 w-5 shrink-0">
                            <svg class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <svg class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                            </svg>
                        </span>
                    </summary>
                    <div class="px-5 pb-5 pt-0 text-sm text-[#94A3B8] leading-relaxed border-t border-white/5 mt-2 pt-4">
                        Your existing links will continue to work perfectly! The 50 links/mo limit only applies to creating *new* links within a calendar month. If you hit the limit, you'll need to upgrade to Creator to create more links for that month.
                    </div>
                </details>

                <details class="group bg-[#1E293B] rounded-2xl border border-white/5 overflow-hidden [&_summary::-webkit-details-marker]:hidden">
                    <summary class="flex cursor-pointer items-center justify-between gap-1.5 p-5 font-semibold text-[#F8FAFC] focus:outline-none focus:bg-white/5 hover:bg-white/[0.02] transition-colors">
                        <span class="text-base">Can I bring my own custom domain?</span>
                        <span class="relative h-5 w-5 shrink-0">
                            <svg class="absolute inset-0 h-5 w-5 opacity-100 group-open:opacity-0 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
                            </svg>
                            <svg class="absolute inset-0 h-5 w-5 opacity-0 group-open:opacity-100 transition-opacity" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M20 12H4" />
                            </svg>
                        </span>
                    </summary>
                    <div class="px-5 pb-5 pt-0 text-sm text-[#94A3B8] leading-relaxed border-t border-white/5 mt-2 pt-4">
                        Yes! With the Creator and Business plans, you can configure your own custom domain (e.g., go.yourbrand.com). We automatically provision SSL certificates and handle all the redirection logic for you.
                    </div>
                </details>

            </div>
        </section>

    </main>
    <Footer />
    
    <script>
        declare global {
            interface Window {
                snap: any;
            }
        }
        document.addEventListener('DOMContentLoaded', () => {
            const checkoutBtns = document.querySelectorAll('.checkout-btn');
            
            checkoutBtns.forEach(btn => {
                btn.addEventListener('click', async (e) => {
                    const button = e.currentTarget as HTMLButtonElement;
                    const plan = button.getAttribute('data-plan');
                    const originalText = button.innerText;
                    
                    try {
                        // Show loading state
                        button.innerText = 'Loading secure checkout...';
                        button.disabled = true;
                        
                        // Call our backend API to generate a transaction token
                        const response = await fetch('/api/checkout', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify({ plan })
                        });
                        
                        const data = await response.json();
                        
                        if (!response.ok) {
                            throw new Error(data.error || 'Checkout failed');
                        }
                        
                        // Trigger Stripe redirect
                        if (data.url) {
                            window.location.href = data.url;
                        } else {
                            throw new Error('No checkout URL returned from server.');
                        }
                        
                    } catch (error: any) {
                        console.error('Checkout error:', error);
                        alert(error.message || "An error occurred during checkout setup.");
                    } finally {
                        // Restore button state
                        button.innerText = originalText;
                        button.disabled = false;
                    }
                });
            });
        });
    </script>
</Layout>
